# ARIA environment — every variable the backend/frontend actually reads.
# Copy to .env and fill in secrets. NEVER commit a real .env (gitignored).
# On Windows, API keys may be stored DPAPI-encrypted as `enc1:<base64>`
# (core/secret_box.py); the app decrypts them automatically at startup.

# ---------- Relational database (goal_agent/agent.py, core/checks.py) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_username
DB_PASSWORD=change_me_before_use
# DB_SCHEMA is only read by the dev benchmark script (benchmark_fk.py).
DB_SCHEMA=public

# ---------- LLM providers (core/config.py PROVIDER_ENV_KEYS, llm_provider.py) --
# GROQ_API_KEY is stored ENCRYPTED at rest using Windows DPAPI, bound to the
# current Windows user. Put a plain key here only for a non-Windows dev box.
# On Windows, set it to `enc1:<base64>` produced by:
#   python -c "import sys; sys.path.insert(0,'.'); from core.secret_box import encrypt; print(encrypt('<KEY>'))"
# The app decrypts it automatically at startup (core/config.py).
GROQ_API_KEY=
# DeepSeek (OpenAI-compatible). Required only when provider "deepseek" is used.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Vision default: falls back to DEEPSEEK_MODEL when empty (llm_provider.py).
DEEPSEEK_VISION_MODEL=
# Reasoning control: "enabled" | "disabled" (anything else -> "disabled").
DEEPSEEK_THINKING=disabled
# OmniRoute gateway. Required only when provider "omniroute" is used.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Grok / xAI (OpenAI-compatible). XAI_API_KEY is accepted as a key alias;
# XAI_MODEL as a model alias (llm_provider.py).
GROK_API_KEY=
# XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini
# XAI_MODEL=
# Master kill-switch for ALL hosted inference: 0/false/no/off disables
# cloud/deepseek/omniroute/grok so Local Ollama works fully offline.
ARIA_CLOUD_ALLOWED=1
# Explicit backend opt-in for hosted inference (default DENY). A frontend
# toggle alone is insufficient — the backend env must grant consent or
# every cloud call raises. Values: 1/true/yes/on.
ARIA_CLOUD_CONSENT=0

# ---------- Auth / sessions (auth.py, api/auth_routes.py) ----------------------
# Empty = auto-generate + persist to data/.jwt_secret (single-machine default).
# In containers/prod, inject a fixed secret here instead.
JWT_SECRET=
# Rotation: set JWT_SECRET to the NEW value and this to the OLD one until
# existing tokens expire (verified for signature only, never issued).
JWT_SECRET_PREVIOUS=
# Token lifetime in days, clamped to 1-7 (default 1).
TOKEN_TTL_DAYS=1
# Auth cookie Secure flag. Default True (prod-safe). Opt out for local HTTP
# dev ONLY via ARIA_COOKIE_SECURE=0 (0/false/no/off) or ARIA_ENV=dev.
# ARIA_COOKIE_SECURE=
# ARIA_ENV= (dev/development/local also relaxes the Secure cookie flag)

# ---------- Server (app.py) ----------------------------------------------------
# Startup port (falls through to the next free port if busy).
ARIA_PORT=8000
# Set to 0/false/no/off to hide /docs, /redoc, /openapi.json in prod.
# Default 0 (docs hidden); set 1 for local dev only.
ARIA_ENABLE_DOCS=0
# Comma-separated extra origins. Same-origin :8000 needs no CORS entry;
# "*" is rejected (incompatible with allow_credentials) and ignored loudly.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---------- Uploads / limits (api/connect_routes.py) ---------------------------
ARIA_MAX_UPLOAD_CSV_MB=100
ARIA_MAX_UPLOAD_PDF_MB=50

# ---------- Rate limits (core/ratelimit.py) ------------------------------------
# Master switch: off/0/false disables all rate limiting (local dev only).
ARIA_RATE_LIMIT=on
# Per-minute budgets for LLM and heavy routes.
ARIA_RL_LLM_MAX=30
ARIA_RL_HEAVY_MAX=60
# Shared rate-limit backend. Default "memory" is single-process only (dev).
# Production multi-worker deployments need a shared store: set ARIA_REDIS_URL
# below (preferred) — the limiter then uses a Redis sliding window shared by
# all workers. An explicit ARIA_RATE_LIMIT_STORE=redis also selects it.
# ARIA_RATE_LIMIT_STORE=memory

# ---------- Shared session / scale-out (core/config.py, core/ratelimit.py) -----
# Redis URL for shared sessions + rate limits (multi-worker production).
# When set, sessions prefer Redis (file store stays as fallback) and rate
# limits use a shared sliding window. Requires `pip install redis`; when the
# package is missing the app logs a warning and falls back (dev compat).
# ARIA_REDIS_URL=redis://localhost:6379/0
# Fail-closed multi-worker guard: 1/true/yes/on makes >1 workers without a
# shared store raise 503 instead of silently enforcing per-process limits.
# ARIA_REQUIRE_SHARED_STORE=0
# Worker count. Single worker (default) is dev-safe with file/memory stores.
# Multi-worker (UVICORN_WORKERS>1 or WEB_CONCURRENCY>1, e.g. gunicorn) without
# ARIA_REDIS_URL logs an error at startup about session divergence and keeps
# per-process stores — set ARIA_REDIS_URL for production scale-out.
# UVICORN_WORKERS=1
# WEB_CONCURRENCY=1

# ---------- Tuning --------------------------------------------------------------
# SQL repair retry budget, seconds (goal_agent/data.py).
ARIA_REPAIR_TIMEOUT=60
# Dashboard KPI cache TTL, seconds (api/kpi_routes.py).
ARIA_DASH_CACHE_TTL=120
# Minimum relevance score for a dashboard KPI card (api/kpi_routes.py).
DASHBOARD_MIN_SCORE=0.35
# Ollama endpoint. OLLAMA_HOST is read by core/checks.py (health probe);
# OLLAMA_BASE_URL by api/settings_routes.py (settings page). Keep in sync.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------- Insight PDF-RAG (insight_rag/config.py) ------------------------------
# Vector store. Empty = local file-backed store under data/insight_rag.
# Set to PostgreSQL + pgvector for the enterprise backend, e.g.
# postgresql://user:pass@localhost:5432/aria_rag
# ARIA_RAG_DATABASE_URL=
# Legacy alias, also honoured: RAG_DATABASE_URL=
ARIA_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG LLM override. Only values starting with "deepseek-" are used;
# otherwise falls back to DEEPSEEK_MODEL above (legacy Groq names ignored).
# ARIA_RAG_LLM_MODEL=
ARIA_RAG_COLLECTION_PREFIX=aria_insight_pdf
ARIA_RAG_ROUTER_MIN_CONFIDENCE=0.62
ARIA_RAG_ROUTER_TIMEOUT_SECONDS=10
# Local cross-encoder rerank: 0/false/no/off disables (graceful fallback).
ARIA_RAG_RERANKER_ENABLED=true
ARIA_RAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ARIA_RAG_RERANKER_TOP_K=10
ARIA_RAG_MAX_PDF_MB=50
ARIA_RAG_MAX_SELECTED_DOCUMENTS=8
ARIA_RAG_TEXT_CHUNK_SIZE=1500
ARIA_RAG_TEXT_CHUNK_OVERLAP=220
ARIA_RAG_TABLE_ROWS_PER_CHUNK=25
ARIA_RAG_TABULAR_MAX_ROW_CHUNKS=12
ARIA_RAG_TABULAR_MAX_ROWS=50000
ARIA_RAG_TABLE_SIBLING_MAX_CHUNKS=16
ARIA_RAG_RETRIEVAL_FETCH_K=18
ARIA_RAG_RETRIEVAL_TOP_K=8
ARIA_RAG_MAX_CONTEXT_CHARS=24000
ARIA_RAG_RECENT_HISTORY_TURNS=8
# Budgets / guards (insight_rag/config.py validate_rag_config enforces minima).
ARIA_RAG_MAX_LLM_CALLS_PER_QUERY=8
ARIA_RAG_VERIFY_TIMEOUT_S=12
ARIA_RAG_QUERY_TIMEOUT_S=120
ARIA_RAG_CIRCUIT_BREAKER_FAILURES=5
ARIA_RAG_CIRCUIT_BREAKER_WINDOW_S=300
ARIA_RAG_BM25_MAX_DOCS=3000
ARIA_RAG_BM25_MAX_CHARS_PER_DOC=8000
ARIA_RAG_LEXICAL_CORPUS_MAX_CHUNKS=3000

# ---------- Dev / benchmarks / tests (not for prod) ------------------------------
# benchmark_fk.py refuses DROP/CREATE DATABASE runs unless this is
# 1/true/yes. Never enable in prod.
# ARIA_ALLOW_BENCHMARK=0
# Gated live-relational tests (tests/test_relational_gated.py): read-only
# SELECT 1 smoke over these URLs. Absent = explicit skip
# `NOT EXECUTED — TEST CREDENTIALS UNAVAILABLE`. Never commit real values.
# POSTGRES_TEST_URL=
# MYSQL_TEST_URL=
# copilot schema rerank (downloads a model; opt-in only).
# ARIA_SCHEMA_RERANK=0
# MySQL CLI default port (schema_agent/connection.py).
# MYSQL_PORT=3306
# Full LLM E2E journey (tests/test_e2e_full.py): cloud|local, else skipped.
# E2E_PROVIDER=

# ---------- Frontend (Vite build-time, aria-frontend/) ---------------------------
# API prefix (default /api, same-origin). Per-request timeout in ms:
# 120000 default in services/api.js, 30000 in figma/lib/decisionCenterApi.ts.
# VITE_API_BASE=/api
# VITE_API_TIMEOUT_MS=120000
# Dev-only: backend target for the Vite 5173 proxy (vite.config.js).
# VITE_BACKEND_TARGET=http://localhost:8000
