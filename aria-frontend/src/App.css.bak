/* =========================================================
   GLOBAL STYLES
========================================================= */

* {
  box-sizing: border-box;
}

html,
body,
#root {
  min-height: 100%;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f5f7fb;
  color: #1f2937;
}

button,
input {
  font: inherit;
}

button {
  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

/* =========================================================
   LOGIN PAGE
========================================================= */

.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
  background: #f0f2f5;
}

.login-card {
  width: 100%;
  max-width: 430px;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 38px;

  box-shadow:
    0 20px 50px rgba(23, 35, 60, 0.08),
    0 5px 15px rgba(23, 35, 60, 0.04);
}

.login-brand {
  margin-bottom: 32px;
}

.login-brand h1 {
  margin: 0;
  color: #17233c;
  font-size: 36px;
  letter-spacing: 1.5px;
}

.login-brand p {
  margin: 7px 0 0;
  color: #4f6cf7;
  font-size: 14px;
  font-weight: 600;
}

.login-heading {
  margin-bottom: 28px;
}

.login-heading h2 {
  margin: 0;
  color: #17233c;
  font-size: 25px;
}

.login-heading p {
  margin: 9px 0 0;
  color: #6b7280;
  font-size: 14px;
  line-height: 1.6;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 19px;
}

.login-form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.login-form-group label {
  color: #374151;
  font-size: 14px;
  font-weight: 600;
}

.login-form-group input {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #d1d5db;
  border-radius: 9px;
  outline: none;
  background: #ffffff;
  color: #1f2937;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.login-form-group input::placeholder {
  color: #9ca3af;
}

.login-form-group input:focus {
  border-color: #4f6cf7;
  box-shadow: 0 0 0 3px rgba(79, 108, 247, 0.15);
}

.login-button {
  width: 100%;
  margin-top: 4px;
  border: none;
  background: #4f6cf7;
  color: white;
  padding: 13px 18px;
  border-radius: 9px;
  font-weight: 600;
  cursor: pointer;
}

.login-button:hover {
  background: #3d5be5;
  box-shadow: 0 8px 18px rgba(79, 108, 247, 0.25);
  transform: translateY(-1px);
}

.login-button:active {
  transform: translateY(0);
}

.login-footer {
  margin: 26px 0 0;
  padding-top: 20px;
  border-top: 1px solid #edf0f5;
  text-align: center;
  color: #9ca3af;
  font-size: 12px;
}

/* =========================================================
   LLM SELECTION PAGE
========================================================= */

.llm-page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  padding: 60px 24px;
  background: #f0f2f5;
}

.llm-container {
  width: 100%;
  max-width: 1000px;
}

.llm-header {
  max-width: 680px;
  margin: 0 auto 36px;
  text-align: center;
}

.llm-header::before {
  content: "ARIA";
  display: inline-block;
  margin-bottom: 15px;
  color: #4f6cf7;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 2px;
}

.llm-header h1 {
  margin: 0;
  color: #17233c;
  font-size: 34px;
}

.llm-header p {
  margin: 14px auto 0;
  color: #6b7280;
  font-size: 15px;
  line-height: 1.7;
}

.llm-options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.llm-card {
  display: flex;
  flex-direction: column;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 30px;
  box-shadow: 0 10px 30px rgba(23, 35, 60, 0.05);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.llm-card:hover {
  transform: translateY(-4px);
  border-color: #b9cdf5;
  box-shadow: 0 18px 40px rgba(23, 35, 60, 0.1);
}

.llm-card-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.llm-card-header h2 {
  margin: 15px 0 0;
  color: #17233c;
  font-size: 24px;
}

.llm-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
  color: #4f6cf7;
  border: 1px solid #dbe4ff;
  padding: 6px 11px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
}

.llm-description {
  margin: 15px 0 22px;
  color: #6b7280;
  font-size: 14px;
  line-height: 1.6;
}

.llm-info {
  flex: 1;
  padding: 17px;
  background: #f8fafc;
  border: 1px solid #edf0f5;
  border-radius: 10px;
}

.llm-info p {
  margin: 0 0 14px;
  color: #4b5563;
  font-size: 14px;
  line-height: 1.55;
}

.llm-info p:last-child {
  margin-bottom: 0;
}

.llm-info strong {
  color: #17233c;
}

.llm-select-button {
  width: 100%;
  margin-top: 24px;
  border: none;
  background: #4f6cf7;
  color: white;
  padding: 13px 18px;
  border-radius: 9px;
  font-weight: 600;
  cursor: pointer;
}

.llm-select-button:hover {
  background: #3d5be5;
  box-shadow: 0 8px 18px rgba(79, 108, 247, 0.25);
}

/* =========================================================
   MAIN APPLICATION
========================================================= */

.app {
  min-height: 100vh;
  display: flex;
}

/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {
  width: 240px;
  min-height: 100vh;
  background: #17233c;
  color: white;
  padding: 30px 22px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.sidebar-top {
  width: 100%;
}

.logo {
  margin: 0;
  font-size: 30px;
  letter-spacing: 1px;
}

.logo-subtitle {
  margin-top: 5px;
  color: #aeb9cc;
  font-size: 13px;
}

.selected-llm {
  display: inline-block;
  margin: 13px 0 0;
  padding: 6px 10px;
  background: rgba(45, 104, 216, 0.18);
  border: 1px solid rgba(96, 150, 255, 0.28);
  border-radius: 20px;
  color: #dbe8ff;
  font-size: 12px;
  font-weight: 600;
}

.nav-menu {
  margin-top: 45px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nav-item {
  width: 100%;
  border: none;
  background: transparent;
  color: #cbd5e1;
  padding: 13px 15px;
  text-align: left;
  border-radius: 8px;
  cursor: pointer;
}

.nav-item:hover {
  background: #223252;
  color: white;
}

.nav-item.active {
  background: #2d68d8;
  color: white;
}

/* =========================================================
   SIDEBAR USER AREA
========================================================= */

.sidebar-user {
  margin-top: 40px;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.sidebar-user-info {
  margin-bottom: 15px;
  overflow: hidden;
}

.sidebar-user-info span {
  display: block;
  margin-bottom: 5px;
  color: #8fa0bb;
  font-size: 11px;
}

.sidebar-user-info strong {
  display: block;
  overflow: hidden;
  color: #f8fafc;
  font-size: 13px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.change-llm-button,
.signout-button {
  width: 100%;
  padding: 10px 12px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
}

.change-llm-button {
  border: 1px solid rgba(133, 173, 255, 0.35);
  background: rgba(45, 104, 216, 0.14);
  color: #dce9ff;
}

.change-llm-button:hover {
  background: rgba(45, 104, 216, 0.28);
  border-color: rgba(133, 173, 255, 0.55);
}

.signout-button {
  margin-top: 9px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: transparent;
  color: #aeb9cc;
}

.signout-button:hover {
  background: #223252;
  color: white;
}

/* =========================================================
   MAIN CONTENT
========================================================= */

.main-content {
  flex: 1;
  padding: 30px 36px;
}

.top-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top-header h2 {
  margin: 0;
  font-size: 26px;
}

.top-header p {
  margin-top: 6px;
  color: #6b7280;
}

.database-status {
  display: flex;
  align-items: center;
  gap: 8px;
  background: white;
  padding: 10px 16px;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
  font-size: 14px;
}

.status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}

.status-dot.connected {
  background: #22c55e;
}

.status-dot.connecting {
  background: #f59e0b;
}

.status-dot.disconnected {
  background: #9ca3af;
}

.status-dot.failed {
  background: #ef4444;
}

/* =========================================================
   ASK ARIA
========================================================= */

.ask-section {
  margin-top: 28px;
  background: white;
  padding: 22px;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
}

.ask-section h3 {
  margin-top: 0;
}

.ask-box {
  display: flex;
  gap: 12px;
}

.ask-box input {
  flex: 1;
  padding: 13px 15px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  outline: none;
}

.ask-box input:focus {
  border-color: #2d68d8;
  box-shadow: 0 0 0 3px rgba(45, 104, 216, 0.08);
}

.ask-box button {
  border: none;
  background: #2d68d8;
  color: white;
  padding: 0 25px;
  border-radius: 8px;
  cursor: pointer;
}

.ask-box button:hover {
  background: #2459bb;
}

.ask-box button:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

/* =========================================================
   KPI CARDS
========================================================= */

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-top: 22px;
}

.kpi-card {
  background: white;
  padding: 22px;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
}

.kpi-card p {
  margin: 0;
  color: #6b7280;
  font-size: 14px;
}

.kpi-card h2 {
  margin: 10px 0;
  font-size: 28px;
}

.kpi-card span {
  color: #9ca3af;
  font-size: 12px;
}

/* =========================================================
   ANALYSIS MESSAGES
========================================================= */

.analysis-message {
  margin: 14px 0 0;
  color: #2d68d8;
  font-size: 14px;
}

.question-result {
  margin-top: 16px;
  padding: 14px 16px;
  background: #f8fafc;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
}

.question-result span {
  display: block;
  color: #6b7280;
  font-size: 12px;
  margin-bottom: 5px;
}

.question-result strong {
  font-size: 14px;
}

/* =========================================================
   DATA SOURCE TYPE SELECTOR
========================================================= */

.source-type-section {
  margin-top: 28px;
}

.source-type-header {
  margin-bottom: 18px;
}

.source-type-header h3 {
  margin: 0;
  color: #17233c;
  font-size: 20px;
}

.source-type-header p {
  margin: 7px 0 0;
  color: #6b7280;
  font-size: 14px;
}

.source-type-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.source-type-card {
  width: 100%;
  min-height: 190px;
  padding: 19px;
  border: 1px solid #e2e8f0;
  border-radius: 13px;
  background: #ffffff;
  text-align: left;
  cursor: pointer;
  color: #1f2937;

  display: flex;
  flex-direction: column;

  box-shadow: 0 5px 16px rgba(23, 35, 60, 0.03);
}

.source-type-card:hover {
  border-color: #a9c2f1;
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(23, 35, 60, 0.07);
}

.source-type-card.selected {
  border-color: #2d68d8;
  background: #f7faff;
  box-shadow: 0 0 0 2px rgba(45, 104, 216, 0.08);
}

.source-type-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.source-type-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 48px;
  height: 32px;
  padding: 0 9px;

  background: #eef4ff;
  color: #2d68d8;
  border: 1px solid #dbe7ff;
  border-radius: 7px;

  font-size: 11px;
  font-weight: 700;
}

.source-type-category {
  color: #9ca3af;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.source-type-card h4 {
  margin: 18px 0 8px;
  color: #17233c;
  font-size: 16px;
}

.source-type-card p {
  flex: 1;
  margin: 0;
  color: #6b7280;
  font-size: 12px;
  line-height: 1.55;
}

.source-select-text {
  display: block;
  margin-top: 17px;
  color: #2d68d8;
  font-size: 12px;
  font-weight: 700;
}

.source-type-card.selected .source-select-text {
  color: #1d4ed8;
}

/* =========================================================
   DATA SOURCE EMPTY STATE
========================================================= */

.source-empty-state {
  margin-top: 24px;
  padding: 38px 24px;
  background: #ffffff;
  border: 1px dashed #cbd5e1;
  border-radius: 12px;
  text-align: center;
}

.source-empty-state h3 {
  margin: 0;
  color: #17233c;
  font-size: 18px;
}

.source-empty-state p {
  margin: 8px 0 0;
  color: #6b7280;
  font-size: 14px;
}

/* =========================================================
   DATABASE / DATA SOURCE CONNECTION CARD
========================================================= */

.connection-card {
  margin-top: 24px;
  background: white;
  padding: 26px;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
}

.connection-card-header h3 {
  margin: 0;
  font-size: 19px;
  color: #17233c;
}

.connection-card-header p {
  margin: 7px 0 0;
  color: #6b7280;
  font-size: 14px;
}

.connection-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 25px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-group.full-width {
  grid-column: 1 / -1;
}

.form-group label {
  font-size: 14px;
  font-weight: 600;
  color: #374151;
}

.form-group input {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  outline: none;
  background: white;
}

.form-group input:focus {
  border-color: #2d68d8;
  box-shadow: 0 0 0 3px rgba(45, 104, 216, 0.08);
}

.form-group input:disabled {
  background: #f3f4f6;
  color: #6b7280;
  cursor: not-allowed;
}

/* =========================================================
   FILE UPLOAD
========================================================= */

.file-upload-area {
  display: flex;
  align-items: center;
  gap: 22px;

  margin-top: 24px;
  padding: 26px;

  background: #f8fafc;
  border: 1px dashed #b8c4d6;
  border-radius: 12px;
}

.file-upload-icon {
  width: 70px;
  height: 70px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  background: #eef4ff;
  color: #2d68d8;
  border: 1px solid #d6e4ff;
  border-radius: 12px;

  font-size: 14px;
  font-weight: 800;
}

.file-upload-content {
  flex: 1;
}

.file-upload-content h4 {
  margin: 0;
  color: #17233c;
  font-size: 16px;
}

.file-upload-content p {
  margin: 7px 0 16px;
  color: #6b7280;
  font-size: 13px;
}

.file-select-button {
  display: inline-block;
  padding: 10px 15px;
  background: #ffffff;
  color: #2d68d8;
  border: 1px solid #b9cdf5;
  border-radius: 8px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 700;
}

.file-select-button:hover {
  background: #eef4ff;
}

.file-input-hidden {
  display: none;
}

/* =========================================================
   SELECTED FILE INFORMATION
========================================================= */

.selected-file-info {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 18px;

  margin-top: 18px;
  padding: 16px;

  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
}

.selected-file-info div {
  min-width: 0;
}

.selected-file-info span {
  display: block;
  margin-bottom: 5px;
  color: #6b7280;
  font-size: 11px;
}

.selected-file-info strong {
  display: block;
  overflow: hidden;
  color: #17233c;
  font-size: 13px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* =========================================================
   DATA SOURCE ACTIONS
========================================================= */

.connection-actions {
  display: flex;
  gap: 12px;
  margin-top: 24px;
}

.connect-button {
  border: none;
  background: #2d68d8;
  color: white;
  padding: 12px 22px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
}

.connect-button:hover {
  background: #2459bb;
}

.connect-button:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.disconnect-button {
  border: 1px solid #fecaca;
  background: #fff7f7;
  color: #b91c1c;
  padding: 11px 18px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
}

.disconnect-button:hover {
  background: #fee2e2;
  border-color: #fca5a5;
}

/* =========================================================
   CONNECTION SUCCESS
========================================================= */

.connection-success {
  display: flex;
  flex-direction: column;
  gap: 5px;

  margin-top: 18px;
  padding: 14px 16px;

  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  color: #166534;
  border-radius: 8px;
}

.connection-success strong {
  font-size: 14px;
}

.connection-success span {
  font-size: 13px;
  line-height: 1.5;
}

/* =========================================================
   CONNECTION ERROR
========================================================= */

.connection-error {
  display: flex;
  flex-direction: column;
  gap: 5px;

  margin-top: 18px;
  padding: 14px 16px;

  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
  border-radius: 8px;
}

.connection-error strong {
  font-size: 14px;
}

.connection-error span {
  font-size: 13px;
  line-height: 1.5;
}

/* =========================================================
   CONNECTION PROCESSING
========================================================= */

.connection-progress {
  display: flex;
  align-items: center;
  gap: 13px;

  margin-top: 18px;
  padding: 14px 16px;

  background: #fffbeb;
  border: 1px solid #fde68a;
  border-radius: 8px;
}

.connection-progress > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.connection-progress strong {
  color: #92400e;
  font-size: 14px;
}

.connection-progress span {
  color: #a16207;
  font-size: 12px;
}

.connection-spinner {
  width: 20px;
  height: 20px;
  flex-shrink: 0;

  border: 3px solid #fde68a;
  border-top-color: #f59e0b;
  border-radius: 50%;

  animation: connection-spin 0.8s linear infinite;
}

@keyframes connection-spin {
  to {
    transform: rotate(360deg);
  }
}

/* =========================================================
   DATA SOURCE DEVELOPMENT / SECURITY NOTE
========================================================= */

.connection-note {
  margin-top: 18px;
  padding: 15px 17px;

  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-left: 4px solid #94a3b8;
  border-radius: 8px;
}

.connection-note strong {
  color: #374151;
  font-size: 13px;
}

.connection-note p {
  margin: 5px 0 0;
  color: #6b7280;
  font-size: 12px;
  line-height: 1.55;
}

/* =========================================================
   OLD SCHEMA AGENT COMPONENT STYLES
========================================================= */

.schema-card {
  margin-top: 22px;
  background: white;
  padding: 22px;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
}

.schema-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.schema-header h3 {
  margin: 0;
}

.schema-header p {
  margin: 6px 0 0;
  color: #6b7280;
  font-size: 14px;
}

.waiting-badge {
  background: #fff7ed;
  color: #c2410c;
  padding: 7px 12px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: bold;
}

.schema-info {
  margin-top: 22px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.schema-info div {
  background: #f8fafc;
  padding: 18px;
  border-radius: 8px;
}

.schema-info span {
  display: block;
  color: #6b7280;
  font-size: 13px;
  margin-bottom: 7px;
}

.schema-info strong {
  font-size: 17px;
}

/* =========================================================
   CURRENT SCHEMA PAGE
========================================================= */

.schema-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 28px;
}

.schema-summary-card {
  background: white;
  padding: 20px;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.schema-summary-card p {
  margin: 0;
  color: #6b7280;
  font-size: 13px;
}

.schema-summary-card h3 {
  margin: 9px 0 0;
  color: #17233c;
  font-size: 20px;
}

.schema-section {
  margin-top: 24px;
  background: white;
  padding: 24px;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.schema-section-header h3 {
  margin: 0;
}

.schema-section-header p {
  margin: 7px 0 0;
  color: #6b7280;
  font-size: 14px;
}

.schema-table-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 22px;
}

.schema-table-card {
  overflow: hidden;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  background: #ffffff;
}

.schema-table-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 16px;
  background: #f8fafc;
  border-bottom: 1px solid #e5e7eb;
}

.schema-table-title h3 {
  margin: 0;
  color: #17233c;
  font-size: 16px;
}

.schema-table-title span {
  color: #6b7280;
  font-size: 12px;
}

.schema-column-header,
.schema-column-row {
  display: grid;
  grid-template-columns: 1.4fr 1fr 0.5fr;
  gap: 12px;
  padding: 11px 16px;
}

.schema-column-header {
  color: #6b7280;
  background: #fbfcfe;
  border-bottom: 1px solid #e5e7eb;
  font-size: 12px;
  font-weight: 700;
}

.schema-column-row {
  border-bottom: 1px solid #f0f2f5;
  color: #374151;
  font-size: 13px;
}

.schema-column-row:last-child {
  border-bottom: none;
}

.relationship-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 20px;
}

.relationship-card {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto;
  align-items: center;
  gap: 14px;
  padding: 14px 16px;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
}

.relationship-card strong {
  color: #17233c;
  font-size: 13px;
}

.relationship-card > span {
  color: #2d68d8;
  font-weight: 700;
}

.relationship-card small {
  padding: 5px 8px;
  background: #eef4ff;
  color: #2d68d8;
  border-radius: 15px;
  font-size: 11px;
}

/* =========================================================
   RESPONSIVE DESIGN
========================================================= */

@media (max-width: 1150px) {
  .source-type-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 1000px) {
  .schema-summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .schema-table-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 850px) {
  .llm-options {
    grid-template-columns: 1fr;
  }

  .llm-container {
    max-width: 600px;
  }

  .app {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    min-height: auto;
    padding: 20px;
  }

  .nav-menu {
    margin-top: 22px;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .nav-item {
    width: auto;
  }

  .sidebar-user {
    margin-top: 24px;
  }

  .main-content {
    padding: 24px;
  }

  .kpi-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 650px) {
  .login-page {
    padding: 20px 15px;
  }

  .login-card {
    padding: 28px 22px;
    border-radius: 14px;
  }

  .login-brand h1 {
    font-size: 31px;
  }

  .llm-page {
    padding: 35px 16px;
  }

  .llm-header h1 {
    font-size: 27px;
  }

  .llm-card {
    padding: 23px;
  }

  .top-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
  }

  .ask-box {
    flex-direction: column;
  }

  .ask-box button {
    padding: 12px 20px;
  }

  .source-type-grid {
    grid-template-columns: 1fr;
  }

  .source-type-card {
    min-height: auto;
  }

  .connection-grid {
    grid-template-columns: 1fr;
  }

  .form-group.full-width {
    grid-column: auto;
  }

  .file-upload-area {
    flex-direction: column;
    align-items: flex-start;
  }

  .selected-file-info {
    grid-template-columns: 1fr;
  }

  .connection-actions {
    flex-direction: column;
  }

  .connect-button,
  .disconnect-button {
    width: 100%;
  }

  .schema-summary {
    grid-template-columns: 1fr;
  }

  .relationship-card {
    grid-template-columns: 1fr;
    gap: 7px;
  }
}
/* =========================================================
   DAY 3 - DATABASE FIELD HELPER TEXT
========================================================= */

.field-helper-text {
  display: block;
  margin-top: 2px;
  color: #7c8798;
  font-size: 12px;
  line-height: 1.5;
}

/* =========================================================
   DAY 3 - SCHEMA SOURCE SUMMARY
========================================================= */

.schema-source-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-top: 28px;
}

.schema-source-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 19px 20px;
}

.schema-source-card span {
  display: block;
  margin-bottom: 8px;
  color: #6b7280;
  font-size: 12px;
}

.schema-source-card strong {
  display: block;
  overflow: hidden;
  color: #17233c;
  font-size: 16px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schema-ready-text {
  color: #15803d !important;
}

/* =========================================================
   DAY 3 - NO DATA SOURCE SCHEMA STATE
========================================================= */

.schema-empty-state {
  margin-top: 28px;
  padding: 46px 30px;
  background: #ffffff;
  border: 1px dashed #cbd5e1;
  border-radius: 14px;
  text-align: center;
}

.schema-empty-icon {
  width: 58px;
  height: 58px;
  margin: 0 auto 17px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #eef4ff;
  border: 1px solid #dbe7ff;
  border-radius: 13px;

  color: #2d68d8;
  font-size: 11px;
  font-weight: 800;
}

.schema-empty-state h3 {
  margin: 0;
  color: #17233c;
  font-size: 20px;
}

.schema-empty-state p {
  max-width: 540px;
  margin: 10px auto 0;
  color: #6b7280;
  font-size: 14px;
  line-height: 1.6;
}

/* =========================================================
   DAY 3 - DEVELOPMENT SCHEMA NOTICE
========================================================= */

.schema-agent-notice {
  margin-top: 22px;
  padding: 17px 19px;

  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;

  background: #eff6ff;
  border: 1px solid #bfdbfe;
  border-radius: 10px;
}

.schema-agent-notice strong {
  display: block;
  color: #1e3a8a;
  font-size: 14px;
}

.schema-agent-notice p {
  margin: 5px 0 0;
  color: #475569;
  font-size: 12px;
  line-height: 1.5;
}

.schema-agent-notice > span {
  flex-shrink: 0;
  padding: 6px 10px;
  background: #ffffff;
  color: #2d68d8;
  border: 1px solid #bfdbfe;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   DAY 3 - SCHEMA AGENT PLACEHOLDER
========================================================= */

.schema-agent-placeholder {
  margin-top: 22px;
  padding: 28px;

  display: flex;
  align-items: flex-start;
  gap: 20px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;

  box-shadow: 0 7px 20px rgba(23, 35, 60, 0.04);
}

.schema-agent-placeholder-icon {
  width: 58px;
  height: 58px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  background: #eef4ff;
  border: 1px solid #dbe7ff;
  border-radius: 12px;

  color: #2d68d8;
  font-size: 15px;
  font-weight: 800;
}

.schema-agent-placeholder h3 {
  margin: 2px 0 0;
  color: #17233c;
  font-size: 20px;
}

.schema-agent-placeholder p {
  max-width: 760px;
  margin: 9px 0 0;
  color: #6b7280;
  font-size: 14px;
  line-height: 1.65;
}

/* =========================================================
   DAY 3 - SCHEMA FLOW PREVIEW
========================================================= */

.schema-flow-preview {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;

  margin-top: 20px;
}

.schema-flow-preview span {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 8px 12px;

  background: #f8fafc;
  border: 1px solid #dbe3ee;
  border-radius: 8px;

  color: #334155;
  font-size: 12px;
  font-weight: 600;
}

.schema-flow-preview b {
  color: #2d68d8;
  font-size: 15px;
}

/* =========================================================
   DAY 3 - RESPONSIVE SCHEMA SOURCE UI
========================================================= */

@media (max-width: 1100px) {
  .schema-source-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 650px) {
  .schema-source-summary {
    grid-template-columns: 1fr;
  }

  .schema-agent-notice {
    align-items: flex-start;
    flex-direction: column;
  }

  .schema-agent-placeholder {
    flex-direction: column;
  }

  .schema-flow-preview {
    align-items: flex-start;
    flex-direction: column;
  }

  .schema-flow-preview b {
    transform: rotate(90deg);
    margin-left: 14px;
  }
}
/* =========================================================
   DAY 5 - ASK ARIA / GOAL AGENT
========================================================= */

.ask-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
}

.ask-section-heading h3 {
  margin: 0;
}

.ask-helper-text {
  margin: 6px 0 0;
  color: #6b7280;
  font-size: 13px;
}

.ask-source-badge {
  display: inline-flex;
  align-items: center;
  max-width: 240px;
  padding: 7px 11px;

  overflow: hidden;

  background: #eef4ff;
  border: 1px solid #dbe7ff;
  border-radius: 20px;

  color: #2d68d8;
  font-size: 11px;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.ask-input-wrapper {
  position: relative;
}

/* =========================================================
   DAY 5 - QUESTION SUGGESTIONS
========================================================= */

.question-suggestions {
  margin-top: 10px;

  overflow: hidden;

  background: #ffffff;
  border: 1px solid #dbe3ee;
  border-radius: 10px;

  box-shadow: 0 10px 25px rgba(23, 35, 60, 0.07);
}

.suggestion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 10px 14px;

  background: #f8fafc;
  border-bottom: 1px solid #e5e7eb;
}

.suggestion-header span {
  color: #475569;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.suggestion-header small {
  color: #2d68d8;
  font-size: 11px;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
}

.suggestion-item {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 11px;

  padding: 12px 14px;

  border: none;
  border-bottom: 1px solid #f0f2f5;

  background: #ffffff;
  color: #334155;

  text-align: left;
  cursor: pointer;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-item:hover {
  background: #f7faff;
}

.suggestion-icon {
  width: 25px;
  height: 25px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  background: #eef4ff;
  color: #2d68d8;

  border-radius: 50%;

  font-size: 12px;
  font-weight: 800;
}

.suggestion-item > span:last-child {
  font-size: 13px;
  line-height: 1.45;
}

/* =========================================================
   DAY 5 - DID YOU MEAN
========================================================= */

.goal-correction-card {
  margin-top: 20px;
  padding: 18px 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  background: #fff7ed;
  border: 1px solid #fed7aa;
  border-radius: 11px;
}

.goal-correction-card > div {
  min-width: 0;
}

.goal-correction-card span {
  display: block;
  margin-bottom: 5px;

  color: #9a3412;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.goal-correction-card strong {
  display: block;

  color: #7c2d12;
  font-size: 15px;
}

.goal-correction-card button {
  flex-shrink: 0;

  border: 1px solid #fdba74;
  background: #ffffff;
  color: #c2410c;

  padding: 9px 13px;

  border-radius: 8px;

  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
}

.goal-correction-card button:hover {
  background: #ffedd5;
}

/* =========================================================
   DAY 5 - GOAL AGENT HEADER
========================================================= */

.goal-agent-header {
  margin-top: 22px;
  padding: 21px 23px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  background: #eff6ff;
  border: 1px solid #bfdbfe;
  border-radius: 12px;
}

.goal-agent-label {
  display: inline-block;

  margin-bottom: 7px;

  color: #2563eb;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.9px;
}

.goal-agent-header h3 {
  margin: 0;

  color: #17233c;
  font-size: 19px;
}

.goal-agent-header p {
  margin: 7px 0 0;

  color: #64748b;
  font-size: 13px;
  line-height: 1.55;
}

.goal-status-badge {
  flex-shrink: 0;

  padding: 7px 12px;

  background: #ffffff;
  color: #15803d;

  border: 1px solid #bbf7d0;
  border-radius: 20px;

  font-size: 11px;
  font-weight: 800;
}

/* =========================================================
   DAY 5 - GOAL RESULT SECTIONS
========================================================= */

.goal-result-section {
  margin-top: 18px;
  padding: 21px 22px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.goal-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;

  margin-bottom: 15px;
}

.goal-section-title h3 {
  margin: 0;

  color: #17233c;
  font-size: 17px;
}

.goal-section-title > span {
  flex-shrink: 0;

  padding: 5px 9px;

  background: #f8fafc;
  color: #64748b;

  border: 1px solid #e2e8f0;
  border-radius: 15px;

  font-size: 10px;
  font-weight: 700;
}

.goal-interpretation {
  margin: 0;

  color: #475569;
  font-size: 14px;
  line-height: 1.65;
}

/* =========================================================
   DAY 5 - CLARIFICATION
========================================================= */

.goal-clarification {
  margin-top: 18px;
  padding: 17px 19px;

  background: #fffbeb;
  border: 1px solid #fde68a;
  border-radius: 10px;
}

.goal-clarification strong {
  color: #92400e;
  font-size: 14px;
}

.goal-clarification p {
  margin: 6px 0 0;

  color: #a16207;
  font-size: 13px;
  line-height: 1.55;
}

/* =========================================================
   DAY 5 - RELEVANT TABLE CHIPS
========================================================= */

.goal-table-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.goal-table-chip {
  display: inline-flex;
  align-items: center;

  padding: 8px 11px;

  background: #eef4ff;
  color: #2459bb;

  border: 1px solid #d6e4ff;
  border-radius: 8px;

  font-size: 12px;
  font-weight: 700;
}

/* =========================================================
   DAY 5 - JOIN / PREPROCESSING STEPS
========================================================= */

.goal-step-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.goal-step-item {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 11px 13px;

  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
}

.goal-step-item > span {
  width: 25px;
  height: 25px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  background: #eaf1ff;
  color: #2d68d8;

  border-radius: 50%;

  font-size: 11px;
  font-weight: 800;
}

.goal-step-item strong {
  color: #475569;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.5;
}

/* =========================================================
   DAY 5 - SQL BLOCK
========================================================= */

.goal-sql-block {
  margin: 0;

  overflow-x: auto;

  padding: 18px;

  background: #17233c;
  border-radius: 9px;

  color: #e2e8f0;

  font-family: "Courier New", Courier, monospace;

  font-size: 12px;
  line-height: 1.65;
  white-space: pre;
}

.goal-sql-block code {
  font-family: inherit;
}

/* =========================================================
   DAY 5 - PROCESSED DATA SUMMARY
========================================================= */

.goal-processing-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;

  margin-top: 18px;
}

.goal-processing-summary > div {
  padding: 18px 20px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 11px;
}

.goal-processing-summary span {
  display: block;

  margin-bottom: 7px;

  color: #6b7280;
  font-size: 11px;
}

.goal-processing-summary strong {
  display: block;

  color: #17233c;
  font-size: 17px;
}

/* =========================================================
   DAY 5 - NEXT AGENT
========================================================= */

.goal-next-agent {
  margin-top: 18px;
  padding: 17px 19px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 10px;
}

.goal-next-agent span {
  color: #166534;
  font-size: 12px;
}

.goal-next-agent strong {
  color: #166534;
  font-size: 14px;
}

/* =========================================================
   DAY 5 - RESPONSIVE
========================================================= */

@media (max-width: 800px) {
  .goal-processing-summary {
    grid-template-columns: 1fr;
  }

  .goal-agent-header,
  .goal-correction-card {
    align-items: flex-start;
    flex-direction: column;
  }

  .goal-section-title {
    align-items: flex-start;
    flex-direction: column;
  }

  .goal-correction-card button {
    width: 100%;
  }
}
/* =========================================================
   DAY 6 - ANALYTICS RESULTS
========================================================= */

.analytics-results {
  margin-top: 28px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* =========================================================
   DAY 6 - ANALYTICS HEADER
========================================================= */

.analytics-result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;

  padding: 24px 26px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.04);
}

.analytics-result-label {
  display: inline-block;

  margin-bottom: 7px;

  color: #2d68d8;

  font-size: 11px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.analytics-result-header h2 {
  margin: 0;

  color: #17233c;

  font-size: 24px;
}

.analytics-result-header p {
  max-width: 650px;

  margin: 8px 0 0;

  color: #6b7280;

  font-size: 14px;
  line-height: 1.6;
}

.analytics-ready-badge {
  flex-shrink: 0;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 7px 12px;

  background: #f0fdf4;

  border: 1px solid #bbf7d0;
  border-radius: 20px;

  color: #15803d;

  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   DAY 6 - KPI CARDS
========================================================= */

.analytics-kpi-grid {
  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 18px;
}

.analytics-kpi-card {
  position: relative;
  overflow: hidden;

  min-height: 125px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 22px 23px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 13px;

  box-shadow: 0 6px 20px rgba(23, 35, 60, 0.035);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.analytics-kpi-card::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;

  width: 4px;
  height: 100%;

  background: #2d68d8;
}

.analytics-kpi-card:hover {
  transform: translateY(-2px);

  border-color: #c6d7f7;

  box-shadow: 0 10px 26px rgba(23, 35, 60, 0.07);
}

.analytics-kpi-label {
  display: block;

  margin-bottom: 10px;

  color: #6b7280;

  font-size: 12px;
  font-weight: 600;
}

.analytics-kpi-value {
  display: block;

  overflow: hidden;

  color: #17233c;

  font-size: 25px;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

/* =========================================================
   DAY 6 - CHART CARD
========================================================= */

.analytics-chart-card {
  overflow: hidden;

  display: flex;
  flex-direction: column;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.04);
}

.analytics-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  padding: 20px 24px;

  background: #ffffff;

  border-bottom: 1px solid #edf0f5;
}

.analytics-card-heading > div:first-child > span {
  display: block;

  margin-bottom: 5px;

  color: #7c8798;

  font-size: 10px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.7px;
}

.analytics-card-heading h3 {
  margin: 0;

  color: #17233c;

  font-size: 18px;
}

.chart-type-badge {
  flex-shrink: 0;

  padding: 7px 11px;

  background: #eef4ff;

  border: 1px solid #dbe7ff;
  border-radius: 18px;

  color: #2d68d8;

  font-size: 11px;
  font-weight: 700;
}

.analytics-chart-wrapper {
  width: 100%;

  padding: 25px 20px 15px;

  background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
}

/* =========================================================
   DAY 6 - RECHARTS IMPROVEMENTS
========================================================= */

.analytics-chart-wrapper .recharts-cartesian-axis-tick-value {
  fill: #64748b;

  font-size: 11px;
}

.analytics-chart-wrapper .recharts-cartesian-grid line {
  stroke: #e8edf4;
}

.analytics-chart-wrapper .recharts-default-tooltip {
  border: 1px solid #e2e8f0 !important;

  border-radius: 8px !important;

  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.08) !important;
}

.analytics-chart-wrapper .recharts-tooltip-label {
  color: #17233c;

  font-weight: 700;
}

/* =========================================================
   DAY 6 - RESULT TABLE CARD
========================================================= */

.analytics-table-card {
  overflow: hidden;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.04);
}

.table-row-count {
  flex-shrink: 0;

  padding: 6px 10px;

  background: #f8fafc;

  border: 1px solid #e2e8f0;
  border-radius: 18px;

  color: #64748b;

  font-size: 11px;
  font-weight: 700;
}

.analytics-table-wrapper {
  width: 100%;

  overflow-x: auto;
}

.analytics-data-table {
  width: 100%;

  border-collapse: collapse;

  background: #ffffff;
}

.analytics-data-table thead {
  background: #f8fafc;
}

.analytics-data-table th {
  padding: 14px 20px;

  border-bottom: 1px solid #e2e8f0;

  color: #475569;

  font-size: 12px;
  font-weight: 700;

  text-align: left;
}

.analytics-data-table td {
  padding: 14px 20px;

  border-bottom: 1px solid #edf0f5;

  color: #374151;

  font-size: 13px;
}

.analytics-data-table tbody tr:last-child td {
  border-bottom: none;
}

.analytics-data-table tbody tr {
  transition: background 0.15s ease;
}

.analytics-data-table tbody tr:hover {
  background: #f8fbff;
}

.analytics-data-table th:last-child,
.analytics-data-table td:last-child {
  text-align: right;
}

/* =========================================================
   DAY 6 - PIPELINE NEXT STEP
========================================================= */

.analytics-next-step {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 18px 22px;

  background: #f7faff;

  border: 1px solid #d9e6fc;
  border-radius: 12px;
}

.analytics-next-step span {
  display: block;

  margin-bottom: 4px;

  color: #64748b;

  font-size: 11px;
}

.analytics-next-step strong {
  color: #1e3a5f;

  font-size: 14px;
}

.analytics-next-arrow {
  width: 35px;
  height: 35px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #2d68d8;

  border-radius: 50%;

  color: #ffffff;

  font-size: 18px;
  font-weight: 700;
}

/* =========================================================
   DAY 6 - UNSUPPORTED CHART
========================================================= */

.chart-unavailable {
  padding: 50px 24px;

  background: #f8fafc;

  border: 1px dashed #cbd5e1;
  border-radius: 10px;

  color: #64748b;

  font-size: 13px;

  text-align: center;
}

/* =========================================================
   DAY 6 - RESPONSIVE TABLET
========================================================= */

@media (max-width: 1000px) {
  .analytics-kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .analytics-kpi-card:last-child {
    grid-column: 1 / -1;
  }
}

/* =========================================================
   DAY 6 - RESPONSIVE MOBILE
========================================================= */

@media (max-width: 700px) {
  .analytics-result-header {
    flex-direction: column;

    padding: 20px;
  }

  .analytics-result-header h2 {
    font-size: 21px;
  }

  .analytics-kpi-grid {
    grid-template-columns: 1fr;
  }

  .analytics-kpi-card:last-child {
    grid-column: auto;
  }

  .analytics-kpi-card {
    min-height: 105px;

    padding: 19px 20px;
  }

  .analytics-kpi-value {
    font-size: 22px;
  }

  .analytics-card-heading {
    align-items: flex-start;
    flex-direction: column;

    padding: 18px 19px;
  }

  .analytics-chart-wrapper {
    padding: 20px 7px 10px;
  }

  .analytics-data-table {
    min-width: 520px;
  }

  .analytics-next-step {
    padding: 16px 18px;
  }
}
/* =========================================================
   DAY 6 - MULTI-CHART DASHBOARD
========================================================= */

.analytics-visualizations-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.analytics-visualizations-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;

  padding: 22px 24px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.04);
}

.analytics-visualizations-heading > div:first-child > span {
  display: block;

  margin-bottom: 6px;

  color: #2d68d8;

  font-size: 10px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.analytics-visualizations-heading h2 {
  margin: 0;

  color: #17233c;

  font-size: 21px;
}

.analytics-visualizations-heading p {
  margin: 7px 0 0;

  color: #6b7280;

  font-size: 13px;
  line-height: 1.5;
}

.visualization-count-badge {
  flex-shrink: 0;

  padding: 7px 12px;

  background: #eef4ff;

  border: 1px solid #dbe7ff;
  border-radius: 20px;

  color: #2d68d8;

  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   MULTI-CHART GRID
========================================================= */

.analytics-chart-grid {
  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 20px;
}

/* One visualization can use full width */

.analytics-chart-grid.single-chart {
  grid-template-columns: 1fr;
}

/* Make chart cards work correctly inside grid */

.analytics-chart-grid .analytics-chart-card {
  min-width: 0;
  height: 100%;
}

/* =========================================================
   RESPONSIVE MULTI-CHART DASHBOARD
========================================================= */

@media (max-width: 1050px) {
  .analytics-chart-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .analytics-visualizations-heading {
    flex-direction: column;

    padding: 18px 19px;
  }

  .analytics-visualizations-heading h2 {
    font-size: 19px;
  }
}
/* =========================================================
   DAY 6 - DASHBOARD TOP SECTION POLISH
   Scoped only to Dashboard so other pages stay unchanged.
========================================================= */

/* =========================================================
   DASHBOARD PAGE HEADER
========================================================= */

.dashboard-page .page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 24px;

  margin-bottom: 24px;
}

.dashboard-page .page-header > div:first-child {
  min-width: 0;
}

.dashboard-page .page-header h1 {
  margin: 0;

  color: #17233c;

  font-size: 34px;
  font-weight: 750;

  line-height: 1.15;
}

.dashboard-page .page-header p {
  margin: 10px 0 0;

  color: #667085;

  font-size: 15px;
  line-height: 1.6;
}

/* =========================================================
   CONNECTED DATA SOURCE STATUS
========================================================= */

.dashboard-source-status {
  min-width: 190px;

  display: flex;
  flex-direction: column;

  gap: 5px;

  padding: 13px 16px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 11px;

  box-shadow: 0 4px 14px rgba(23, 35, 60, 0.035);
}

.source-status-label {
  color: #7c8798;

  font-size: 10px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.7px;
}

.dashboard-source-status strong {
  overflow: hidden;

  color: #17233c;

  font-size: 14px;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

/* =========================================================
   ASK ARIA CARD
========================================================= */

.dashboard-page > .section-card:first-of-type {
  margin-bottom: 20px;

  padding: 24px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.04);
}

.ask-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 18px;
}

.ask-section-heading h3 {
  margin: 0;

  color: #17233c;

  font-size: 21px;
  font-weight: 700;
}

.ask-helper-text {
  margin: 6px 0 0;

  color: #6b7280;

  font-size: 13px;
  line-height: 1.5;
}

.ask-source-badge {
  flex-shrink: 0;

  display: inline-flex;
  align-items: center;

  padding: 8px 12px;

  background: #eef4ff;

  border: 1px solid #d4e2ff;
  border-radius: 20px;

  color: #2563eb;

  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   ASK ARIA INPUT
========================================================= */

.ask-input-wrapper {
  width: 100%;

  display: flex;
  align-items: stretch;

  gap: 10px;
}

.ask-input-wrapper input {
  min-width: 0;
  height: 48px;

  flex: 1;

  padding: 0 16px;

  background: #ffffff;

  border: 1px solid #d7deea;
  border-radius: 9px;

  outline: none;

  color: #17233c;

  font-family: inherit;
  font-size: 14px;

  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease;
}

.ask-input-wrapper input::placeholder {
  color: #98a2b3;
}

.ask-input-wrapper input:focus {
  border-color: #3973df;

  box-shadow: 0 0 0 3px rgba(45, 104, 216, 0.11);
}

.ask-input-wrapper input:disabled {
  background: #f8fafc;

  color: #94a3b8;

  cursor: not-allowed;
}

/* =========================================================
   ANALYZE BUTTON
========================================================= */

.ask-input-wrapper .primary-button {
  min-width: 118px;
  height: 48px;

  padding: 0 20px;

  background: #2d68d8;

  border: 1px solid #2d68d8;
  border-radius: 9px;

  color: #ffffff;

  font-family: inherit;
  font-size: 13px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background 0.18s ease,
    transform 0.18s ease,
    box-shadow 0.18s ease;
}

.ask-input-wrapper .primary-button:hover:not(:disabled) {
  background: #2459bc;

  box-shadow: 0 6px 16px rgba(45, 104, 216, 0.2);
}

.ask-input-wrapper .primary-button:active:not(:disabled) {
  transform: translateY(1px);
}

.ask-input-wrapper .primary-button:disabled {
  opacity: 0.65;

  cursor: not-allowed;
}

/* =========================================================
   QUESTION RECEIVED
========================================================= */

.submitted-question {
  display: flex;
  flex-direction: column;

  gap: 6px;

  padding: 17px 20px;

  background: #f8fbff;

  border: 1px solid #dce8fb;
  border-radius: 11px;
}

.submitted-question span {
  color: #64748b;

  font-size: 10px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.65px;
}

.submitted-question strong {
  color: #17233c;

  font-size: 14px;
  font-weight: 700;
}

/* =========================================================
   GENERAL DASHBOARD SECTION CARDS
========================================================= */

.dashboard-page .section-card {
  margin-bottom: 20px;
}

/* =========================================================
   RESPONSIVE DASHBOARD TOP
========================================================= */

@media (max-width: 800px) {
  .dashboard-page .page-header {
    flex-direction: column;
  }

  .dashboard-source-status {
    width: 100%;
  }

  .ask-section-heading {
    flex-direction: column;
  }

  .ask-source-badge {
    align-self: flex-start;
  }

  .ask-input-wrapper {
    flex-direction: column;
  }

  .ask-input-wrapper .primary-button {
    width: 100%;
  }

  .dashboard-page .page-header h1 {
    font-size: 28px;
  }
}
/* =========================================================
   DAY 6 - PROFESSIONAL MOBILE NAVIGATION
========================================================= */

/*
   Desktop wrapper for the existing sidebar.
   The sidebar itself remains unchanged.
*/

.sidebar-shell {
  flex: 0 0 240px;
  min-height: 100vh;

  /* Keep the entire left column dark blue */
  align-self: stretch;
  background: #17233c;
}

.sidebar-shell > .sidebar {
  width: 100%;
  min-height: 100vh;
  height: 100%;
}
.app {
  align-items: stretch;
}

/* Hidden on desktop */

.mobile-topbar,
.mobile-sidebar-overlay {
  display: none;
}

/* =========================================================
   MOBILE / TABLET NAVIGATION
========================================================= */

@media (max-width: 850px) {
  html,
  body,
  #root {
    width: 100%;
    overflow-x: hidden;
  }

  /*
     The mobile application no longer places
     the full sidebar above the page.
  */

  .app {
    display: block;
    min-height: 100vh;
  }

  /* =======================================================
     MOBILE TOP BAR
  ======================================================= */

  .mobile-topbar {
    position: sticky;
    top: 0;
    z-index: 1200;

    width: 100%;
    height: 64px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 14px;

    padding: 0 18px;

    background: #17233c;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);

    box-shadow: 0 4px 14px rgba(23, 35, 60, 0.12);
  }

  /* =======================================================
     MOBILE BRAND
  ======================================================= */

  .mobile-topbar-brand {
    min-width: 0;

    display: flex;
    align-items: center;

    gap: 11px;
  }

  .mobile-topbar-brand strong {
    color: #ffffff;

    font-size: 21px;
    font-weight: 800;

    letter-spacing: 0.8px;
  }

  .mobile-llm-badge {
    display: inline-flex;
    align-items: center;

    padding: 5px 9px;

    background: rgba(45, 104, 216, 0.2);

    border: 1px solid rgba(96, 150, 255, 0.32);

    border-radius: 16px;

    color: #dbe8ff;

    font-size: 10px;
    font-weight: 700;

    white-space: nowrap;
  }

  /* =======================================================
     HAMBURGER BUTTON
  ======================================================= */

  .mobile-menu-button {
    width: 40px;
    height: 40px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    background: rgba(255, 255, 255, 0.06);

    border: 1px solid rgba(255, 255, 255, 0.14);

    border-radius: 9px;

    color: #ffffff;

    cursor: pointer;

    font-size: 23px;
    line-height: 1;
  }

  .mobile-menu-button:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  /* =======================================================
     MOBILE SIDEBAR DRAWER
  ======================================================= */

  .sidebar-shell {
    position: fixed;

    top: 64px;
    left: 0;
    bottom: 0;

    z-index: 1150;

    width: min(320px, 86vw);

    flex: none;

    transform: translateX(-105%);

    transition: transform 0.25s ease;

    pointer-events: none;
  }

  .sidebar-shell.open {
    transform: translateX(0);

    pointer-events: auto;
  }

  /*
     Override the old mobile sidebar rule.
     It now lives inside the slide-out drawer.
  */

  .sidebar-shell .sidebar {
    width: 100%;
    height: 100%;

    min-height: 0;

    padding: 22px 20px;

    overflow-y: auto;

    box-shadow: 10px 0 30px rgba(15, 23, 42, 0.18);
  }

  /*
     Brand and LLM mode are already displayed
     in the mobile top bar.
  */

  .sidebar-shell .logo,
  .sidebar-shell .logo-subtitle,
  .sidebar-shell .selected-llm {
    display: none;
  }

  /* =======================================================
     MOBILE NAVIGATION ITEMS
  ======================================================= */

  .sidebar-shell .nav-menu {
    margin-top: 0;

    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;

    gap: 8px;
  }

  .sidebar-shell .nav-item {
    width: 100%;

    padding: 13px 15px;

    text-align: left;
  }

  /* =======================================================
     MOBILE USER AREA
  ======================================================= */

  .sidebar-shell .sidebar-user {
    margin-top: 30px;

    padding-top: 20px;
  }

  /* =======================================================
     BACKDROP
  ======================================================= */

  .mobile-sidebar-overlay {
    position: fixed;

    top: 64px;
    left: 0;
    right: 0;
    bottom: 0;

    z-index: 1100;

    display: block;

    width: 100%;

    padding: 0;

    background: rgba(15, 23, 42, 0.38);

    border: none;

    cursor: pointer;
  }

  /* =======================================================
     MAIN MOBILE CONTENT
  ======================================================= */

  .main-content {
    width: 100%;
    min-width: 0;

    padding: 20px 16px 28px;
  }
}

/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 480px) {
  .mobile-topbar {
    height: 60px;

    padding: 0 14px;
  }

  .mobile-topbar-brand {
    gap: 8px;
  }

  .mobile-topbar-brand strong {
    font-size: 19px;
  }

  .mobile-llm-badge {
    padding: 4px 8px;

    font-size: 9px;
  }

  .mobile-menu-button {
    width: 38px;
    height: 38px;
  }

  .sidebar-shell {
    top: 60px;

    width: min(300px, 88vw);
  }

  .mobile-sidebar-overlay {
    top: 60px;
  }

  .main-content {
    padding: 18px 14px 26px;
  }
}

/* =========================================================
   DAY 7 - INSIGHT AGENT
========================================================= */

.insight-agent-section {
  margin-top: 28px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* =========================================================
   DAY 7 - INSIGHT AGENT PROCESSING
========================================================= */

.insight-processing-card {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  padding: 25px 26px;
  background: linear-gradient(135deg, #f7faff 0%, #ffffff 100%);
  border: 1px solid #cfe0fb;
  border-radius: 14px;
  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.04);
}

.insight-processing-icon {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef4ff;
  border: 1px solid #d6e4ff;
  border-radius: 12px;
}

.insight-spinner {
  width: 23px;
  height: 23px;
  border: 3px solid #cdddf8;
  border-top-color: #2d68d8;
  border-radius: 50%;
  animation: insight-spin 0.8s linear infinite;
}

@keyframes insight-spin {
  to {
    transform: rotate(360deg);
  }
}

.insight-processing-content {
  min-width: 0;
  flex: 1;
}

.insight-agent-label {
  display: inline-block;
  margin-bottom: 7px;
  color: #2d68d8;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.9px;
}

.insight-processing-content h2 {
  margin: 0;
  color: #17233c;
  font-size: 21px;
}

.insight-processing-content > p {
  max-width: 760px;
  margin: 8px 0 0;
  color: #64748b;
  font-size: 13px;
  line-height: 1.6;
}

.insight-processing-list {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 17px;
}

.insight-processing-list span {
  display: inline-flex;
  align-items: center;
  padding: 7px 10px;
  background: #ffffff;
  border: 1px solid #dbe7fb;
  border-radius: 18px;
  color: #475569;
  font-size: 11px;
  font-weight: 600;
}

.insight-processing-list span::before {
  content: "";
  width: 6px;
  height: 6px;
  margin-right: 7px;
  background: #2d68d8;
  border-radius: 50%;
}

/* =========================================================
   DAY 7 - INSIGHT AGENT SUCCESS HEADER
========================================================= */

.insight-agent-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  padding: 24px 26px;
  background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 68%);
  border: 1px solid #cdeed7;
  border-radius: 14px;
  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.04);
}

.insight-agent-header h2 {
  margin: 0;
  color: #17233c;
  font-size: 24px;
}

.insight-agent-header p {
  max-width: 680px;
  margin: 8px 0 0;
  color: #64748b;
  font-size: 14px;
  line-height: 1.6;
}

.insight-ready-badge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 7px 12px;
  background: #ffffff;
  border: 1px solid #bbf7d0;
  border-radius: 20px;
  color: #15803d;
  font-size: 11px;
  font-weight: 800;
}

/* =========================================================
   DAY 7 - KEY INSIGHTS
========================================================= */

.insight-key-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.insight-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 22px 24px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.04);
}

.insight-section-heading > div:first-child > span {
  display: block;
  margin-bottom: 6px;
  color: #2d68d8;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.insight-section-heading h2 {
  margin: 0;
  color: #17233c;
  font-size: 21px;
}

.insight-section-heading p {
  margin: 7px 0 0;
  color: #6b7280;
  font-size: 13px;
  line-height: 1.5;
}

.insight-count-badge {
  flex-shrink: 0;
  padding: 7px 12px;
  background: #eef4ff;
  border: 1px solid #dbe7ff;
  border-radius: 20px;
  color: #2d68d8;
  font-size: 11px;
  font-weight: 700;
}

.insight-key-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.insight-key-card {
  min-width: 0;
  min-height: 210px;
  display: flex;
  flex-direction: column;
  padding: 21px 22px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 13px;
  box-shadow: 0 6px 20px rgba(23, 35, 60, 0.035);
}

.insight-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.insight-number {
  color: #9aa5b5;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.6px;
}

.insight-impact-badge {
  display: inline-flex;
  align-items: center;
  padding: 5px 9px;
  border-radius: 16px;
  font-size: 10px;
  font-weight: 800;
  text-transform: capitalize;
}

.insight-impact-badge.high {
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
}

.insight-impact-badge.medium {
  background: #fffbeb;
  border: 1px solid #fde68a;
  color: #a16207;
}

.insight-impact-badge.low {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  color: #15803d;
}

.insight-key-card h3 {
  margin: 0;
  color: #17233c;
  font-size: 16px;
  line-height: 1.4;
}

.insight-key-card p {
  margin: 10px 0 0;
  color: #64748b;
  font-size: 13px;
  line-height: 1.65;
}

/* =========================================================
   DAY 7 - TRENDS & PATTERNS
========================================================= */

.insight-trends-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.insight-trend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.insight-trend-card {
  min-width: 0;
  min-height: 175px;

  display: flex;
  align-items: flex-start;
  gap: 16px;

  padding: 21px 22px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 13px;

  box-shadow: 0 6px 20px rgba(23, 35, 60, 0.035);
}

.insight-trend-card.up {
  border-left: 4px solid #16a34a;
}

.insight-trend-card.down {
  border-left: 4px solid #dc2626;
}

.insight-trend-card.mixed {
  border-left: 4px solid #d97706;
}

.insight-trend-icon {
  width: 42px;
  height: 42px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 11px;

  color: #334155;

  font-size: 21px;
  font-weight: 800;
}

.insight-trend-content {
  min-width: 0;
  flex: 1;
}

.insight-trend-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin-bottom: 12px;
}

.insight-direction-badge {
  display: inline-flex;
  align-items: center;

  padding: 5px 9px;

  border-radius: 16px;

  font-size: 10px;
  font-weight: 800;
}

.insight-direction-badge.up {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  color: #15803d;
}

.insight-direction-badge.down {
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
}

.insight-direction-badge.mixed {
  background: #fffbeb;
  border: 1px solid #fde68a;
  color: #a16207;
}

.insight-trend-card h3 {
  margin: 0;

  color: #17233c;

  font-size: 16px;
  line-height: 1.4;
}

.insight-trend-card p {
  margin: 9px 0 0;

  color: #64748b;

  font-size: 13px;
  line-height: 1.65;
}

/* =========================================================
   DAY 7 - ANOMALY DETECTION
========================================================= */

.insight-anomalies-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.insight-anomaly-count-badge {
  flex-shrink: 0;
  padding: 7px 12px;
  background: #fff7ed;
  border: 1px solid #fed7aa;
  border-radius: 20px;
  color: #c2410c;
  font-size: 11px;
  font-weight: 700;
}

.insight-anomaly-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.insight-anomaly-card {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 21px 22px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 13px;
  box-shadow: 0 6px 20px rgba(23, 35, 60, 0.035);
}

.insight-anomaly-card.high {
  border-left: 4px solid #dc2626;
}

.insight-anomaly-card.medium {
  border-left: 4px solid #f59e0b;
}

.insight-anomaly-card.low {
  border-left: 4px solid #2563eb;
}

.insight-anomaly-icon {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff7ed;
  border: 1px solid #fed7aa;
  border-radius: 11px;
  color: #c2410c;
  font-size: 20px;
  font-weight: 900;
}

.insight-anomaly-content {
  min-width: 0;
  flex: 1;
}

.insight-anomaly-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.insight-severity-badge {
  display: inline-flex;
  align-items: center;
  padding: 5px 9px;
  border-radius: 16px;
  font-size: 10px;
  font-weight: 800;
  text-transform: capitalize;
}

.insight-severity-badge.high {
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
}

.insight-severity-badge.medium {
  background: #fffbeb;
  border: 1px solid #fde68a;
  color: #a16207;
}

.insight-severity-badge.low {
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  color: #1d4ed8;
}

.insight-anomaly-card h3 {
  margin: 0;
  color: #17233c;
  font-size: 16px;
  line-height: 1.4;
}

.insight-anomaly-card p {
  margin: 9px 0 0;
  color: #64748b;
  font-size: 13px;
  line-height: 1.65;
}

/* =========================================================
   DAY 7 - INSIGHT AGENT FAILURE
========================================================= */

.insight-error-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 22px 24px;
  background: #fffafa;
  border: 1px solid #fecaca;
  border-radius: 14px;
}

.insight-error-card h3 {
  margin: 0;
  color: #991b1b;
  font-size: 18px;
}

.insight-error-card p {
  margin: 7px 0 0;
  color: #b91c1c;
  font-size: 13px;
  line-height: 1.55;
}

.insight-failed-badge {
  flex-shrink: 0;
  padding: 6px 10px;
  background: #ffffff;
  border: 1px solid #fecaca;
  border-radius: 18px;
  color: #b91c1c;
  font-size: 11px;
  font-weight: 800;
}

/* =========================================================
   DAY 7 - RESPONSIVE INSIGHT AGENT
========================================================= */

@media (max-width: 1050px) {
  .insight-key-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .insight-trend-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .insight-processing-card {
    flex-direction: column;
    padding: 20px;
  }

  .insight-processing-content h2 {
    font-size: 19px;
  }

  .insight-agent-header,
  .insight-section-heading,
  .insight-error-card {
    flex-direction: column;
    padding: 20px;
  }

  .insight-agent-header h2 {
    font-size: 21px;
  }

  .insight-ready-badge,
  .insight-failed-badge {
    align-self: flex-start;
  }

  .insight-key-grid {
    grid-template-columns: 1fr;
  }

  .insight-key-card {
    min-height: auto;
  }

  .insight-trend-card {
    min-height: auto;
    padding: 18px;
  }

  .insight-trend-icon {
    width: 38px;
    height: 38px;
    font-size: 19px;
  }
}

/* =========================================================
   DAY 7 - ANOMALY RESPONSIVE
========================================================= */

@media (max-width: 700px) {
  .insight-anomaly-card {
    padding: 18px;
  }

  .insight-anomaly-icon {
    width: 38px;
    height: 38px;
    font-size: 18px;
  }

  .insight-anomaly-top {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }

  .insight-anomaly-count-badge {
    align-self: flex-start;
  }
}
/* =========================================================
   DAY 7 - RANKED HYPOTHESES
========================================================= */

.insight-hypotheses-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.insight-hypothesis-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.insight-hypothesis-card {
  min-width: 0;

  display: flex;
  align-items: stretch;

  overflow: hidden;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 6px 20px rgba(23, 35, 60, 0.035);
}

/* =========================================================
   HYPOTHESIS RANK
========================================================= */

.insight-hypothesis-rank {
  width: 90px;

  flex-shrink: 0;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 5px;

  padding: 22px 14px;

  background: linear-gradient(180deg, #eef4ff 0%, #f8fbff 100%);

  border-right: 1px solid #dbe7ff;
}

.insight-hypothesis-rank span {
  color: #64748b;

  font-size: 9px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.7px;
}

.insight-hypothesis-rank strong {
  color: #2d68d8;

  font-size: 24px;
  font-weight: 800;
}

/* =========================================================
   HYPOTHESIS CONTENT
========================================================= */

.insight-hypothesis-content {
  min-width: 0;

  flex: 1;

  padding: 22px 24px;
}

.insight-hypothesis-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;
}

.insight-hypothesis-label {
  display: block;

  margin-bottom: 7px;

  color: #7c8798;

  font-size: 9px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.7px;
}

.insight-hypothesis-top h3 {
  margin: 0;

  color: #17233c;

  font-size: 17px;
  line-height: 1.4;
}

.insight-hypothesis-description {
  margin: 11px 0 0;

  color: #64748b;

  font-size: 13px;
  line-height: 1.65;
}

/* =========================================================
   CONFIDENCE BADGE
========================================================= */

.insight-confidence-badge {
  min-width: 92px;

  flex-shrink: 0;

  display: flex;
  flex-direction: column;
  align-items: center;

  padding: 9px 12px;

  background: #f0fdf4;

  border: 1px solid #bbf7d0;
  border-radius: 10px;
}

.insight-confidence-badge strong {
  color: #15803d;

  font-size: 17px;
  font-weight: 800;
}

.insight-confidence-badge span {
  margin-top: 2px;

  color: #16a34a;

  font-size: 9px;
  font-weight: 700;

  text-transform: uppercase;
  letter-spacing: 0.4px;
}

/* =========================================================
   SUPPORTING EVIDENCE
========================================================= */

.insight-evidence-section {
  margin-top: 18px;

  padding-top: 16px;

  border-top: 1px solid #edf0f5;
}

.insight-evidence-title {
  display: block;

  margin-bottom: 11px;

  color: #475569;

  font-size: 10px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.6px;
}

.insight-evidence-list {
  display: flex;
  flex-direction: column;

  gap: 8px;
}

.insight-evidence-item {
  display: flex;
  align-items: flex-start;

  gap: 10px;
}

.insight-evidence-dot {
  width: 7px;
  height: 7px;

  flex-shrink: 0;

  margin-top: 6px;

  background: #2d68d8;

  border-radius: 50%;
}

.insight-evidence-item p {
  margin: 0;

  color: #64748b;

  font-size: 12px;
  line-height: 1.55;
}

/* =========================================================
   RANKED HYPOTHESES RESPONSIVE
========================================================= */

@media (max-width: 700px) {
  .insight-hypothesis-card {
    flex-direction: column;
  }

  .insight-hypothesis-rank {
    width: 100%;

    flex-direction: row;
    justify-content: flex-start;

    padding: 12px 18px;

    border-right: none;
    border-bottom: 1px solid #dbe7ff;
  }

  .insight-hypothesis-rank strong {
    font-size: 18px;
  }

  .insight-hypothesis-content {
    padding: 18px;
  }

  .insight-hypothesis-top {
    flex-direction: column;
  }

  .insight-confidence-badge {
    align-items: flex-start;
  }
}
/* =========================================================
   DAY 7 STEP 8 - BUSINESS RECOMMENDATIONS
========================================================= */

.insight-recommendations-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* =========================================================
   RECOMMENDATION COUNT
========================================================= */

.insight-recommendation-count-badge {
  flex-shrink: 0;

  padding: 7px 12px;

  background: #f0fdf4;

  border: 1px solid #bbf7d0;
  border-radius: 20px;

  color: #15803d;

  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   RECOMMENDATION GRID
========================================================= */

.insight-recommendation-grid {
  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 18px;
}

/* =========================================================
   RECOMMENDATION CARD
========================================================= */

.insight-recommendation-card {
  position: relative;

  min-width: 0;
  min-height: 235px;

  display: flex;
  flex-direction: column;

  padding: 21px 22px;

  overflow: hidden;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 6px 20px rgba(23, 35, 60, 0.035);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.insight-recommendation-card:hover {
  transform: translateY(-2px);

  box-shadow: 0 10px 26px rgba(23, 35, 60, 0.07);
}

/* Priority accent */

.insight-recommendation-card.high {
  border-top: 4px solid #dc2626;
}

.insight-recommendation-card.medium {
  border-top: 4px solid #f59e0b;
}

.insight-recommendation-card.low {
  border-top: 4px solid #16a34a;
}

/* =========================================================
   CARD TOP
========================================================= */

.insight-recommendation-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin-bottom: 17px;
}

.insight-recommendation-number {
  color: #9aa5b5;

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 0.6px;
}

/* =========================================================
   PRIORITY BADGES
========================================================= */

.insight-priority-badge {
  display: inline-flex;
  align-items: center;

  padding: 5px 9px;

  border-radius: 16px;

  font-size: 10px;
  font-weight: 800;

  text-transform: capitalize;
}

.insight-priority-badge.high {
  background: #fef2f2;

  border: 1px solid #fecaca;

  color: #b91c1c;
}

.insight-priority-badge.medium {
  background: #fffbeb;

  border: 1px solid #fde68a;

  color: #a16207;
}

.insight-priority-badge.low {
  background: #f0fdf4;

  border: 1px solid #bbf7d0;

  color: #15803d;
}

/* =========================================================
   RECOMMENDATION ICON
========================================================= */

.insight-recommendation-icon {
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 15px;

  background: #eef4ff;

  border: 1px solid #dbe7ff;
  border-radius: 10px;

  color: #2d68d8;

  font-size: 18px;
  font-weight: 800;
}

/* =========================================================
   RECOMMENDATION CONTENT
========================================================= */

.insight-recommendation-card h3 {
  margin: 0;

  color: #17233c;

  font-size: 16px;
  line-height: 1.4;
}

.insight-recommendation-card p {
  margin: 10px 0 0;

  color: #64748b;

  font-size: 13px;
  line-height: 1.65;
}

/* =========================================================
   STEP 8 RESPONSIVE TABLET
========================================================= */

@media (max-width: 1050px) {
  .insight-recommendation-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* =========================================================
   STEP 8 RESPONSIVE MOBILE
========================================================= */

@media (max-width: 700px) {
  .insight-recommendation-grid {
    grid-template-columns: 1fr;
  }

  .insight-recommendation-card {
    min-height: auto;

    padding: 18px;
  }

  .insight-recommendation-count-badge {
    align-self: flex-start;
  }
}
/* =========================================================
   DAY 7 STEP 9 - PREDICTIONS
========================================================= */

.insight-predictions-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* =========================================================
   PREDICTION COUNT
========================================================= */

.insight-prediction-count-badge {
  flex-shrink: 0;

  padding: 7px 12px;

  background: #f5f3ff;

  border: 1px solid #ddd6fe;
  border-radius: 20px;

  color: #6d28d9;

  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   PREDICTION GRID
========================================================= */

.insight-prediction-grid {
  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 18px;
}

/* =========================================================
   PREDICTION CARD
========================================================= */

.insight-prediction-card {
  min-width: 0;

  display: flex;
  flex-direction: column;

  padding: 22px 23px;

  background: linear-gradient(145deg, #ffffff 0%, #faf9ff 100%);

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 6px 20px rgba(23, 35, 60, 0.035);
}

.insight-prediction-card.high {
  border-left: 4px solid #16a34a;
}

.insight-prediction-card.medium {
  border-left: 4px solid #7c3aed;
}

.insight-prediction-card.low {
  border-left: 4px solid #f59e0b;
}

/* =========================================================
   PREDICTION TOP
========================================================= */

.insight-prediction-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin-bottom: 16px;
}

.insight-prediction-number {
  color: #9aa5b5;

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 0.6px;
}

/* =========================================================
   CONFIDENCE BADGES
========================================================= */

.insight-prediction-confidence {
  display: inline-flex;
  align-items: center;

  padding: 5px 9px;

  border-radius: 16px;

  font-size: 10px;
  font-weight: 800;
}

.insight-prediction-confidence.high {
  background: #f0fdf4;

  border: 1px solid #bbf7d0;

  color: #15803d;
}

.insight-prediction-confidence.medium {
  background: #f5f3ff;

  border: 1px solid #ddd6fe;

  color: #6d28d9;
}

.insight-prediction-confidence.low {
  background: #fffbeb;

  border: 1px solid #fde68a;

  color: #a16207;
}

/* =========================================================
   PREDICTION ICON
========================================================= */

.insight-prediction-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 14px;

  background: #f5f3ff;

  border: 1px solid #ddd6fe;
  border-radius: 11px;

  color: #7c3aed;

  font-size: 20px;
  font-weight: 800;
}

/* =========================================================
   PREDICTION CONTENT
========================================================= */

.insight-prediction-label {
  display: block;

  margin-bottom: 7px;

  color: #7c3aed;

  font-size: 9px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.7px;
}

.insight-prediction-card h3 {
  margin: 0;

  color: #17233c;

  font-size: 17px;
  line-height: 1.45;
}

.insight-prediction-card > p {
  margin: 10px 0 0;

  color: #64748b;

  font-size: 13px;
  line-height: 1.65;
}

/* =========================================================
   PREDICTION DISCLAIMER
========================================================= */

.insight-prediction-note {
  margin-top: 18px;

  padding-top: 14px;

  border-top: 1px solid #ede9fe;
}

.insight-prediction-note span {
  display: block;

  margin-bottom: 4px;

  color: #6d28d9;

  font-size: 10px;
  font-weight: 800;
}

.insight-prediction-note p {
  margin: 0;

  color: #7c8798;

  font-size: 11px;
  line-height: 1.5;
}

/* =========================================================
   STEP 9 RESPONSIVE
========================================================= */

@media (max-width: 900px) {
  .insight-prediction-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .insight-prediction-card {
    padding: 18px;
  }

  .insight-prediction-top {
    align-items: flex-start;

    flex-direction: column;
  }

  .insight-prediction-count-badge {
    align-self: flex-start;
  }
}
/* =========================================================
   DAY 7 STEP 10 - BUSINESS STORY / EXECUTIVE SUMMARY
========================================================= */

.insight-business-story-section {
  display: flex;
  flex-direction: column;
}

/* =========================================================
   BUSINESS STORY CARD
========================================================= */

.insight-business-story-card {
  overflow: hidden;

  background: linear-gradient(135deg, #17233c 0%, #1f3153 100%);

  border: 1px solid #263b63;
  border-radius: 15px;

  box-shadow: 0 10px 30px rgba(23, 35, 60, 0.12);
}

/* =========================================================
   BUSINESS STORY HEADER
========================================================= */

.insight-business-story-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  padding: 23px 25px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.insight-business-story-label {
  display: block;

  margin-bottom: 7px;

  color: #9ec1ff;

  font-size: 10px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.9px;
}

.insight-business-story-top h2 {
  margin: 0;

  color: #ffffff;

  font-size: 22px;
  line-height: 1.35;
}

.insight-business-story-badge {
  flex-shrink: 0;

  display: inline-flex;
  align-items: center;

  padding: 7px 11px;

  background: rgba(255, 255, 255, 0.08);

  border: 1px solid rgba(255, 255, 255, 0.14);

  border-radius: 20px;

  color: #dbe8ff;

  font-size: 10px;
  font-weight: 700;
}

/* =========================================================
   BUSINESS STORY CONTENT
========================================================= */

.insight-business-story-content {
  display: flex;
  align-items: flex-start;

  gap: 18px;

  padding: 25px;
}

.insight-business-story-icon {
  width: 52px;
  height: 52px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(45, 104, 216, 0.24);

  border: 1px solid rgba(133, 173, 255, 0.28);

  border-radius: 12px;

  color: #cfe0ff;

  font-size: 11px;
  font-weight: 900;

  letter-spacing: 0.6px;
}

.insight-business-story-content p {
  flex: 1;

  margin: 0;

  color: #e2e8f0;

  font-size: 14px;
  line-height: 1.8;

  white-space: pre-line;
}

/* =========================================================
   BUSINESS STORY FOOTER
========================================================= */

.insight-business-story-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 16px;

  padding: 14px 25px;

  background: rgba(15, 23, 42, 0.18);

  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.insight-business-story-footer span {
  color: #94a3b8;

  font-size: 10px;
}

.insight-business-story-footer strong {
  color: #bfdbfe;

  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   STEP 10 RESPONSIVE
========================================================= */

@media (max-width: 700px) {
  .insight-business-story-top {
    flex-direction: column;

    padding: 20px;
  }

  .insight-business-story-badge {
    align-self: flex-start;
  }

  .insight-business-story-content {
    flex-direction: column;

    padding: 20px;
  }

  .insight-business-story-footer {
    align-items: flex-start;
    flex-direction: column;

    padding: 14px 20px;
  }

  .insight-business-story-content p {
    font-size: 13px;
  }
}
/* =========================================================
   DAY 7 STEP 11B - INSIGHT AGENT RETRY BUTTON
========================================================= */

.insight-retry-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  margin-top: 14px;

  padding: 9px 15px;

  background: #ffffff;

  border: 1px solid #dc2626;
  border-radius: 8px;

  color: #b91c1c;

  font-size: 12px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.insight-retry-button:hover {
  background: #fef2f2;

  border-color: #b91c1c;

  transform: translateY(-1px);
}

.insight-retry-button:focus-visible {
  outline: 3px solid rgba(220, 38, 38, 0.18);
  outline-offset: 2px;
}

@media (max-width: 700px) {
  .insight-retry-button {
    width: 100%;
  }
}
/* =========================================================
   DAY 8 - FEEDBACK AGENT
========================================================= */

.feedback-agent-section {
  margin-top: 28px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

/* =========================================================
   FEEDBACK HEADER
========================================================= */

.feedback-agent-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;

  padding: 24px 26px;

  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 8px 24px rgba(23, 35, 60, 0.04);
}

.feedback-agent-label {
  display: inline-block;
  margin-bottom: 7px;

  color: #7c3aed;

  font-size: 10px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.9px;
}

.feedback-agent-header h2 {
  margin: 0;

  color: #17233c;

  font-size: 23px;
}

.feedback-agent-header p {
  max-width: 650px;

  margin: 8px 0 0;

  color: #64748b;

  font-size: 14px;
  line-height: 1.6;
}

.feedback-agent-badge {
  flex-shrink: 0;

  display: inline-flex;
  align-items: center;

  padding: 7px 12px;

  background: #f5f3ff;
  border: 1px solid #ddd6fe;
  border-radius: 20px;

  color: #7c3aed;

  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   FEEDBACK QUESTION CARDS
========================================================= */

.feedback-question-card {
  padding: 22px 24px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 13px;

  box-shadow: 0 6px 20px rgba(23, 35, 60, 0.035);
}

.feedback-question-label {
  display: block;

  margin-bottom: 7px;

  color: #7c3aed;

  font-size: 10px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.7px;
}

.feedback-question-card h3 {
  margin: 0;

  color: #17233c;

  font-size: 17px;
}

.feedback-question-card > p {
  margin: 8px 0 0;

  color: #64748b;

  font-size: 13px;
  line-height: 1.6;
}

/* =========================================================
   USEFUL / NOT USEFUL
========================================================= */

.feedback-choice-group {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;

  margin-top: 17px;
}

.feedback-choice-button {
  min-width: 120px;

  padding: 10px 16px;

  background: #ffffff;
  color: #475569;

  border: 1px solid #d5dce7;
  border-radius: 8px;

  cursor: pointer;

  font-size: 13px;
  font-weight: 700;
}

.feedback-choice-button:hover {
  background: #f7faff;

  border-color: #9db9ed;

  color: #2d68d8;
}

.feedback-choice-button.active {
  background: #eef4ff;

  border-color: #2d68d8;

  color: #1d4ed8;

  box-shadow: 0 0 0 2px rgba(45, 104, 216, 0.08);
}

/* =========================================================
   STAR RATING
========================================================= */

.feedback-star-group {
  display: flex;
  align-items: center;
  gap: 7px;

  margin-top: 15px;
}

.feedback-star {
  width: 42px;
  height: 42px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0;

  background: #ffffff;

  border: 1px solid #d9e0ea;
  border-radius: 8px;

  color: #cbd5e1;

  cursor: pointer;

  font-size: 20px;
}

.feedback-star:hover {
  border-color: #fbbf24;

  color: #f59e0b;

  transform: translateY(-1px);
}

.feedback-star.active {
  background: #fffbeb;

  border-color: #fbbf24;

  color: #f59e0b;
}

.feedback-rating-text {
  margin: 10px 0 0 !important;

  color: #92400e !important;

  font-size: 12px !important;
  font-weight: 700;
}

/* =========================================================
   CORRECTION TEXTAREA
========================================================= */

.feedback-correction-input {
  width: 100%;
  min-height: 110px;

  margin-top: 16px;

  padding: 13px 14px;

  resize: vertical;

  background: #ffffff;

  border: 1px solid #d5dce7;
  border-radius: 9px;

  outline: none;

  color: #334155;

  font-family: inherit;
  font-size: 13px;
  line-height: 1.6;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.feedback-correction-input::placeholder {
  color: #94a3b8;
}

.feedback-correction-input:focus {
  border-color: #7c3aed;

  box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.08);
}

/* =========================================================
   SUBMIT AREA
========================================================= */

.feedback-submit-area {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;

  padding: 20px 22px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 13px;
}

.feedback-submit-button {
  min-width: 165px;

  padding: 11px 18px;

  border: none;
  border-radius: 9px;

  background: #2d68d8;

  color: #ffffff;

  cursor: pointer;

  font-size: 13px;
  font-weight: 700;
}

.feedback-submit-button:hover:not(:disabled) {
  background: #2459bb;

  box-shadow: 0 8px 18px rgba(45, 104, 216, 0.18);

  transform: translateY(-1px);
}

.feedback-submit-button:disabled {
  opacity: 0.55;

  cursor: not-allowed;
}

.feedback-required-text {
  color: #94a3b8;

  font-size: 12px;
}

/* =========================================================
   SUCCESS MESSAGE
========================================================= */

.feedback-success-message {
  padding: 17px 19px;

  background: #f0fdf4;

  border: 1px solid #bbf7d0;
  border-radius: 10px;
}

.feedback-success-message strong {
  display: block;

  color: #166534;

  font-size: 14px;
}

.feedback-success-message p {
  margin: 5px 0 0;

  color: #15803d;

  font-size: 12px;
  line-height: 1.5;
}

/* =========================================================
   ERROR MESSAGE
========================================================= */

.feedback-error-message {
  padding: 17px 19px;

  background: #fef2f2;

  border: 1px solid #fecaca;
  border-radius: 10px;
}

.feedback-error-message strong {
  display: block;

  color: #b91c1c;

  font-size: 14px;
}

.feedback-error-message p {
  margin: 5px 0 0;

  color: #dc2626;

  font-size: 12px;
  line-height: 1.5;
}

/* =========================================================
   DAY 8 - FEEDBACK RESPONSIVE
========================================================= */

@media (max-width: 700px) {
  .feedback-agent-header {
    flex-direction: column;

    padding: 20px;
  }

  .feedback-question-card {
    padding: 19px;
  }

  .feedback-choice-group {
    flex-direction: column;
  }

  .feedback-choice-button {
    width: 100%;
  }

  .feedback-star {
    width: 39px;
    height: 39px;

    font-size: 18px;
  }

  .feedback-submit-area {
    align-items: stretch;
    flex-direction: column;
  }

  .feedback-submit-button {
    width: 100%;
  }
}
/* =========================================================
   DAY 8 - FEEDBACK REACTIONS
========================================================= */

.feedback-reaction-group {
  display: grid;

  grid-template-columns: repeat(5, minmax(0, 1fr));

  gap: 12px;

  margin-top: 18px;
}

.feedback-reaction {
  min-height: 105px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 9px;

  padding: 14px 10px;

  background: #ffffff;

  border: 1px solid #dbe2ec;
  border-radius: 12px;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.feedback-reaction:hover {
  transform: translateY(-2px);

  background: #f8fbff;

  border-color: #9db9ed;

  box-shadow: 0 7px 18px rgba(23, 35, 60, 0.06);
}

.feedback-reaction.active {
  background: #eef4ff;

  border-color: #2d68d8;

  box-shadow: 0 0 0 2px rgba(45, 104, 216, 0.08);
}

.feedback-reaction-emoji {
  font-size: 31px;

  line-height: 1;
}

.feedback-reaction-label {
  color: #64748b;

  font-size: 11px;
  font-weight: 700;
}

.feedback-reaction.active .feedback-reaction-label {
  color: #1d4ed8;
}

/* =========================================================
   REACTION RESPONSIVE
========================================================= */

@media (max-width: 700px) {
  .feedback-reaction-group {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .feedback-reaction {
    min-height: 95px;
  }
}

@media (max-width: 450px) {
  .feedback-reaction-group {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
/* =========================================================
   DAY 8 - INDIVIDUAL OUTPUT FEEDBACK
========================================================= */

.individual-feedback {
  margin-top: 18px;
  padding-top: 16px;

  border-top: 1px solid #edf0f5;
}

.individual-feedback-question {
  display: block;

  margin-bottom: 10px;

  color: #64748b;

  font-size: 11px;
  font-weight: 700;
}

.individual-feedback-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.individual-feedback-button {
  min-width: 118px;
  padding: 8px 14px;

  background: #eef4ff;
  color: #2563eb;

  border: 1px solid #bfdbfe;
  border-radius: 9px;

  cursor: pointer;

  font-size: 11px;
  font-weight: 700;

  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.08);

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.individual-feedback-button:hover {
  background: #dbeafe;
  border-color: #93c5fd;
  color: #1d4ed8;

  transform: translateY(-1px);

  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
}

/* =========================================================
   INDIVIDUAL FEEDBACK - MOBILE
========================================================= */

@media (max-width: 700px) {
  .individual-feedback-actions {
    flex-direction: column;
  }

  .individual-feedback-button {
    width: 100%;
  }
}
/* =========================================================
   DAY 8 - FINAL INDIVIDUAL FEEDBACK SELECTED STATES
   Keep this at the VERY END of App.css
========================================================= */

/* Correct / positive selected */

.individual-feedback-button.active:not(.negative) {
  background: #16a34a !important;
  border-color: #15803d !important;
  color: #ffffff !important;

  box-shadow: 0 4px 12px rgba(22, 163, 74, 0.28) !important;
}

/* Incorrect / negative selected */

.individual-feedback-button.active.negative {
  background: #dc2626 !important;
  border-color: #b91c1c !important;
  color: #ffffff !important;

  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.28) !important;
}

/* Keep selected colors while hovering */

.individual-feedback-button.active:not(.negative):hover {
  background: #15803d !important;
  border-color: #166534 !important;
  color: #ffffff !important;
}

.individual-feedback-button.active.negative:hover {
  background: #b91c1c !important;
  border-color: #991b1b !important;
  color: #ffffff !important;
}

/* Remove the black browser focus appearance,
   but still keep an accessible visible focus */

.individual-feedback-button:focus-visible {
  outline: none;

  box-shadow: 0 0 0 3px rgba(45, 104, 216, 0.18);
}

.individual-feedback-button.active:not(.negative):focus-visible {
  outline: none;

  box-shadow:
    0 0 0 3px rgba(22, 163, 74, 0.22),
    0 4px 12px rgba(22, 163, 74, 0.24) !important;
}

.individual-feedback-button.active.negative:focus-visible {
  outline: none;

  box-shadow:
    0 0 0 3px rgba(220, 38, 38, 0.2),
    0 4px 12px rgba(220, 38, 38, 0.24) !important;
}
/* =========================================================
   DAY 8 - HYPOTHESIS FEEDBACK STATES
========================================================= */

.individual-feedback-button.active.partial {
  background: #f59e0b !important;
  border-color: #d97706 !important;
  color: #ffffff !important;

  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25) !important;
}

.individual-feedback-button.active.partial:hover {
  background: #d97706 !important;
  border-color: #b45309 !important;
  color: #ffffff !important;
}

.individual-feedback-button.active.unsure {
  background: #64748b !important;
  border-color: #475569 !important;
  color: #ffffff !important;

  box-shadow: 0 4px 12px rgba(100, 116, 139, 0.24) !important;
}

.individual-feedback-button.active.unsure:hover {
  background: #475569 !important;
  border-color: #334155 !important;
  color: #ffffff !important;
}
/* =========================================================
   DAY 8 - CHART FEEDBACK CENTER ALIGNMENT
========================================================= */

.chart-feedback-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
}

.chart-feedback-block .individual-feedback-question {
  margin-bottom: 12px;
  text-align: center;
}

.chart-feedback-block .individual-feedback-actions {
  justify-content: center;
}
/* =========================================================
   DAY 8 - CHART FEEDBACK FINAL POLISH
========================================================= */

.chart-feedback-block {
  padding: 18px 16px;
}

.chart-feedback-block .individual-feedback-actions {
  gap: 10px;
}

.chart-feedback-block .individual-feedback-button {
  min-width: 125px;
  max-width: 145px;
  padding: 8px 14px;
}

.chart-feedback-block .individual-feedback-button.active:not(.negative) {
  box-shadow: 0 3px 9px rgba(22, 163, 74, 0.18) !important;
}

.chart-feedback-block .individual-feedback-button.active.negative {
  box-shadow: 0 3px 9px rgba(220, 38, 38, 0.18) !important;
}
/* =========================================================
   DAY 8 - BEST HYPOTHESIS SELECTION
========================================================= */

.best-hypothesis-list {
  display: flex;
  flex-direction: column;
  gap: 10px;

  margin-top: 17px;
}

.best-hypothesis-option {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 13px;

  padding: 13px 15px;

  background: #f8fbff;

  border: 1px solid #dbe7f8;
  border-radius: 10px;

  color: #334155;

  text-align: left;
  cursor: pointer;

  box-shadow: 0 2px 7px rgba(23, 35, 60, 0.035);
}

.best-hypothesis-option:hover {
  background: #eef4ff;

  border-color: #9db9ed;
}

.best-hypothesis-option.active {
  background: #eaf2ff;

  border-color: #2d68d8;

  box-shadow: 0 0 0 2px rgba(45, 104, 216, 0.1);
}

.best-hypothesis-number {
  width: 31px;
  height: 31px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  background: #ffffff;

  border: 1px solid #cbdaf3;
  border-radius: 50%;

  color: #2563eb;

  font-size: 12px;
  font-weight: 800;
}

.best-hypothesis-option.active .best-hypothesis-number {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff;
}

.best-hypothesis-option > div {
  min-width: 0;
}

.best-hypothesis-option strong {
  display: block;

  color: #17233c;

  font-size: 13px;
  line-height: 1.45;
}

.best-hypothesis-option small {
  display: block;

  margin-top: 4px;

  color: #64748b;

  font-size: 10px;
}
/* =========================================================
   DAY 9 - HISTORY PAGE
========================================================= */

.history-page {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.history-count-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 9px 14px;

  background: #eef4ff;
  color: #2563eb;

  border: 1px solid #bfdbfe;
  border-radius: 999px;

  font-size: 12px;
  font-weight: 700;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.history-card {
  background: #ffffff;

  border: 1px solid #dbe3ef;
  border-radius: 18px;

  padding: 22px;

  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.history-card:hover {
  transform: translateY(-2px);

  border-color: #bfd3ff;

  box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
}

.history-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 20px;
}

.history-card-label {
  display: block;

  margin-bottom: 7px;

  color: #64748b;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.history-card-top h3 {
  margin: 0;

  color: #17233c;

  font-size: 19px;
  line-height: 1.4;
}

.history-status-badge {
  flex-shrink: 0;

  padding: 7px 11px;

  background: #ecfdf3;
  color: #15803d;

  border: 1px solid #bbf7d0;
  border-radius: 999px;

  font-size: 11px;
  font-weight: 800;
}

.history-card-meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));

  gap: 14px;

  padding: 18px;

  background: #f8fafc;

  border: 1px solid #e8edf5;
  border-radius: 14px;
}

.history-card-meta div {
  min-width: 0;
}

.history-card-meta span {
  display: block;

  margin-bottom: 5px;

  color: #64748b;

  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.history-card-meta strong {
  display: block;

  color: #17233c;

  font-size: 13px;
  font-weight: 700;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;

  margin-top: 18px;
  padding-top: 16px;

  border-top: 1px solid #edf1f6;

  color: #64748b;

  font-size: 11px;
  font-weight: 600;
}

/* =========================================================
   DAY 9 - HISTORY MOBILE
========================================================= */

@media (max-width: 768px) {
  .history-card {
    padding: 18px;
  }

  .history-card-top {
    flex-direction: column;
  }

  .history-card-meta {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .history-card-footer {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 480px) {
  .history-card-meta {
    grid-template-columns: 1fr;
  }
}
/* =========================================================
   DAY 9 - HISTORY SEARCH
========================================================= */

.history-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
}

.history-search-input {
  width: 100%;
  min-height: 46px;

  padding: 0 15px;

  background: #ffffff;
  color: #17233c;

  border: 1px solid #d7dfeb;
  border-radius: 12px;

  font-size: 13px;

  outline: none;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.history-search-input:focus {
  border-color: #2563eb;

  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.history-search-input::placeholder {
  color: #94a3b8;
}
/* =========================================================
   DAY 9 - OPEN HISTORY ANALYSIS
========================================================= */

.history-card-footer-info {
  display: flex;
  align-items: center;
  gap: 18px;
}

.history-open-button {
  padding: 9px 15px;

  background: #2563eb;
  color: #ffffff;

  border: 1px solid #2563eb;
  border-radius: 10px;

  font-size: 12px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.history-open-button:hover {
  background: #1d4ed8;
  border-color: #1d4ed8;
  transform: translateY(-1px);
}

@media (max-width: 768px) {
  .history-card-footer-info {
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .history-open-button {
    width: 100%;
  }
}
/* =========================================================
   DAY 9 - HISTORY SOURCE FILTER
========================================================= */

.history-filter-select {
  min-width: 170px;
  min-height: 46px;

  padding: 0 14px;

  background: #ffffff;
  color: #334155;

  border: 1px solid #d7dfeb;
  border-radius: 12px;

  font-size: 12px;
  font-weight: 600;

  outline: none;
  cursor: pointer;
}

.history-filter-select:focus {
  border-color: #2563eb;

  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

@media (max-width: 768px) {
  .history-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .history-filter-select {
    width: 100%;
  }
}
/* =========================================================
   DAY 9 - SAVED REPORT ACTIONS
========================================================= */

.saved-report-remove-button {
  padding: 9px 15px;

  background: #ffffff;
  color: #dc2626;

  border: 1px solid #fecaca;
  border-radius: 10px;

  font-size: 12px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.saved-report-remove-button:hover {
  background: #fef2f2;
  border-color: #fca5a5;
  transform: translateY(-1px);
}

@media (max-width: 768px) {
  .saved-report-remove-button {
    width: 100%;
  }
}
/* =========================================================
   DAY 9 - DELETE HISTORY ACTION
========================================================= */

.history-delete-button {
  padding: 9px 15px;

  background: #ffffff;
  color: #b91c1c;

  border: 1px solid #fecaca;
  border-radius: 10px;

  font-size: 12px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.history-delete-button:hover {
  background: #fef2f2;
  border-color: #fca5a5;
  transform: translateY(-1px);
}

@media (max-width: 768px) {
  .history-delete-button {
    width: 100%;
  }
}
/* =========================================================
   DAY 9 - MOBILE SIDEBAR FIRST ITEM FIX
========================================================= */

@media (max-width: 850px) {
  .sidebar-shell .sidebar-top {
    padding-top: 34px;
  }
}

@media (max-width: 480px) {
  .sidebar-shell .sidebar-top {
    padding-top: 30px;
  }
}
/* =========================================================
   DAY 10 - HELP & SUPPORT
========================================================= */

.help-page {
  padding: 36px;
  max-width: 1200px;
  margin: 0 auto;
}

.help-page .page-header {
  margin-bottom: 28px;
}

.help-page .page-header h1 {
  margin: 0 0 10px;
  font-size: 2.4rem;
  color: #14233f;
}

.help-page .page-header p {
  margin: 0;
  font-size: 1rem;
  color: #64748b;
}

.help-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.help-card {
  background: #ffffff;
  border: 1px solid #dfe6f0;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
}

.help-card h3 {
  margin: 0 0 12px;
  font-size: 1.15rem;
  color: #14233f;
}

.help-card p {
  margin: 0;
  line-height: 1.65;
  color: #64748b;
}

/* Tablet / Mobile */
@media (max-width: 768px) {
  .help-page {
    padding: 22px 16px;
  }

  .help-page .page-header h1 {
    font-size: 2rem;
  }

  .help-grid {
    grid-template-columns: 1fr;
  }
}
/* =========================================================
   DAY 10 - ALIGN CHART FEEDBACK
========================================================= */

.analytics-chart-card .chart-feedback-block {
  margin-top: auto;
}
/* =========================================================
   DAY 10 - TABLET/MOBILE FEEDBACK SUBMIT ALIGNMENT
========================================================= */
/* =========================================================
   DAY 10 - TABLET / MOBILE FEEDBACK SUBMIT FIX
========================================================= */

@media (max-width: 768px) {
  .feedback-submit-area {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .feedback-submit-button {
    width: 100%;
  }

  .feedback-required-text {
    display: block;
    width: 100%;
    text-align: center;
    line-height: 1.4;
  }
}
/* =========================================================
   DAY 10 - LONG SQL SAFETY
========================================================= */

.goal-sql-block {
  max-width: 100%;
  overflow-x: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.goal-sql-block code {
  white-space: inherit;
}
/* =========================================================
   DAY 10 - TABLE OVERFLOW SAFETY
========================================================= */

.analytics-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.analytics-data-table {
  width: 100%;
  border-collapse: collapse;
}

.analytics-data-table th,
.analytics-data-table td {
  max-width: 260px;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
  vertical-align: top;
}
/* =========================================================
   AUTH - CREATE ACCOUNT / BACK TO LOGIN LINK
========================================================= */

.register-login-link {
  width: 100%;
  margin-top: 10px;
  padding: 13px 18px;

  background: #f8fafc;
  color: #2563eb;

  border: 1px solid #cbd5e1;
  border-radius: 10px;

  font-size: 0.95rem;
  font-weight: 700;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.register-login-link:hover {
  background: #eff6ff;
  border-color: #93c5fd;
}

.register-login-link:active {
  transform: translateY(1px);
}
